<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>Foxhound_Blueprint</defName>
		<label>猎狐犬</label>
		<description>在过去，猎狐犬是为军警部门设计和制造的4×4装甲型响应和救援车辆，从镇压暴乱到突袭行动都能看见它的身影。它有着7厘米厚钢制保险杠和坚固的装甲，但又能和普通卡车一样快速，毕竟为了创造“和平”无需忍受任何障碍。不过现在，它是您在边缘世界维护您独裁统治的强力助手。\n\n&lt;color=#bb8f04&gt;乘员:&lt;/color&gt; 驾驶员 x1, 乘客 x6\n&lt;color=#bb8f04&gt;动力:&lt;/color&gt; 化合燃料</description>
		<designationCategory>VF_Vehicles</designationCategory>
		
		<graphicData>
			<texPath>Things/Vehicles/Foxhound/Foxhound</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,6)</drawSize>
		</graphicData>
		
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToBuild>28000</WorkToBuild>
			<Flammability>0.05</Flammability>
		</statBases>
		
		<size>(2,5)</size>
		
		<constructionSkillPrerequisite>10</constructionSkillPrerequisite>	
		<researchPrerequisites Inherit="False">
			<li>MediumEngineering</li>
		</researchPrerequisites>
		
		<costList>
			<EngineMedium>1</EngineMedium>
			<ComponentHeavyCasting>10</ComponentHeavyCasting>
			<ComponentWheelTire>4</ComponentWheelTire>
			<SimplePlates>70</SimplePlates>
			<StrongPlates>50</StrongPlates>
		</costList>
		
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		
		<thingToSpawn>Foxhound</thingToSpawn>
	</Vehicles.VehicleBuildDef>
</Defs>
