		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>Canister_Diesel</fuelType>
				<fuelConsumptionRate>40</fuelConsumptionRate>
				<fuelConsumptionWorldMultiplier>1.7</fuelConsumptionWorldMultiplier>
				<fuelCapacity>120</fuelCapacity>
			</li>
		</comps>
	</Vehicles.VehicleDef>
