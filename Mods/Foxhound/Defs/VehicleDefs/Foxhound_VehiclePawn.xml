<?xml version="1.0" encoding="utf-8" ?>

<Defs>	
	<Vehicles.VehicleDef ParentName="BaseVehiclePawn">
		<defName>Foxhound</defName>
		<label>猎狐犬</label>
		<description>在过去，猎狐犬是为军警部门设计和制造的4×4装甲型响应和救援车辆，从镇压暴乱到突袭行动都能看见它的身影。它有着7厘米厚钢制保险杠和坚固的装甲，但又能和普通卡车一样快速，毕竟为了创造“和平”无需忍受任何障碍。不过现在，它是您在边缘世界维护您独裁统治的强力助手。\n\n&lt;color=#bb8f04&gt;乘员:&lt;/color&gt; 驾驶员 x1, 乘客 x6\n&lt;color=#bb8f04&gt;动力:&lt;/color&gt; 化合燃料</description>
		
		<graphicData>
			<texPath>Things/Vehicles/Foxhound/Foxhound</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(3,6)</drawSize>
			<color>(49, 49, 49)</color>
			<colorTwo>(49, 49, 49)</colorTwo>
			<colorThree>(49, 49, 49)</colorThree>
		</graphicData>
		
		<fillPercent>1</fillPercent>
		
		<buildDef>Foxhound_Blueprint</buildDef>
		
		<size>(2,5)</size>
		
		<vehicleMovementPermissions>DriverNeeded</vehicleMovementPermissions>
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Industrial</techLevel>
		<vehicleType>Land</vehicleType>
		
		<statBases>
			<ArmorRating_Blunt>5</ArmorRating_Blunt>
			<ArmorRating_Sharp>2</ArmorRating_Sharp>
			<ArmorRating_Heat>1.0</ArmorRating_Heat>
			<Flammability>0.5</Flammability>
			<MarketValue>5500</MarketValue>
		</statBases>
		
		<vehicleStats>
			<Mass>900</Mass>
			<MoveSpeed>9</MoveSpeed>
			<CargoCapacity>800</CargoCapacity>
			<RepairRate>0.95</RepairRate>
		</vehicleStats>
		
		<race>
			<baseBodySize>3.25</baseBodySize>
		</race>
		
		<properties>
			<customRoadCosts AssignDefaults = "0.25"/>
		
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>
						<li>Movement</li>
					</handlingTypes>
				</li>
				<li>
					<key>passenger</key>
					<label>Passenger</label>
					<slots>6</slots>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>Engine</key>
				<label>Engine</label>
				<health>85</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<radius>3</radius>
						<damageDef>Bomb</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Front</side>
				</hitbox>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>FrontLeftWheel</key>
				<label>Front Left Wheel</label>
				<health>45</health>
				<depth>External</depth>
				
				<armor>
					<ArmorRating_Blunt>2</ArmorRating_Blunt>
					<ArmorRating_Sharp>1</ArmorRating_Sharp>
				</armor>
					
				<tags>
					<li>Wheel</li>
				</tags>
				
				<hitbox>
					<fallthrough>false</fallthrough>
					<cells>
						<li>(0, 2)</li>
					</cells>
				</hitbox>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>FrontRightWheel</key>
