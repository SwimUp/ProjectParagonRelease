<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable"><!-- 建筑形态的载具，基本上与BuildingDef相同-->
		<defName>DumpTruck_Blueprint</defName>
		<label>DumpTruck</label>
		<description>Terror incarnation, car accident disclaimer, otherworldly portal - you can call it whatever you want, but in reality it's just a less useful mud truck</description>
		<designationCategory>VF_Vehicles</designationCategory>
		
		<graphicData>
			<texPath>Vehicles/DumpTruck/DumpTruck</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,6)</drawSize>
		</graphicData>
		
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToBuild>45000</WorkToBuild>
			<Flammability>0.05</Flammability>
		</statBases>
		
		<size>(2,5)</size>
		
		<constructionSkillPrerequisite>14</constructionSkillPrerequisite>	
		<researchPrerequisites Inherit="False">
			<li>HeavyEngineering</li>
		</researchPrerequisites>
		
		<costList>
			<EngineHeavy>1</EngineHeavy>
			<ComponentHeavyCasting>30</ComponentHeavyCasting>
			<ComponentWheelTire>4</ComponentWheelTire>
			<SimplePlates>50</SimplePlates>
			<StrongPlates>25</StrongPlates>
		</costList>
		
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		
		<thingToSpawn>TC_DumpTruck</thingToSpawn><!-- 建造后生成的载具Kind,这是与建筑唯一不一样的-->
	</Vehicles.VehicleBuildDef>
</Defs>
