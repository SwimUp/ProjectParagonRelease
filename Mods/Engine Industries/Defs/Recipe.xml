	<RecipeDef ParentName="Recipe_MakeEngineBase">
		<defName>Make_EngineAssemble_Light</defName>
		<label>assemble light engine</label>
		<description>assemble a light engine, which is common used by motor boat, motorcycle and light aircraft.</description>
		<workAmount>20000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>MechanismComplex</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>SimpleElectronic</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>SimplePlates</li>
					</thingDefs>
				</filter>
				<count>50</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>MechanismComplex</li>
				<li>SimpleElectronic</li>
				<li>SimplePlates</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<EngineLight>1</EngineLight>
		</products>
		<skillRequirements>
			<Crafting>4</Crafting>
		</skillRequirements>
		<researchPrerequisite>MechanicalEngineeringBasics</researchPrerequisite>
		<recipeUsers>
			<li>TableMachining</li>
			<li>TableMachiningAdvanced</li>
			<li>RoboticBench</li>
		</recipeUsers>
	</RecipeDef>
