<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<ProjectParagon.Settings.ProjectParagonSettingsDef>
		<defName>Easy</defName>
		<label>Easy</label>
		<description>This settings template is recommended for beginners. The difficulty level of many mechanics has been reduced.</description>
		<settings>
			<li Class="ProjectParagon.Settings.FoodSettings">
				<foodNeedsMult>0.5</foodNeedsMult>
				<customFoodNutrition>1</customFoodNutrition>
			</li>
			<li Class="ProjectParagon.Settings.WorldSettings">
				<preventPlayerNuclearProgram>false</preventPlayerNuclearProgram>
				<nuclearWarChance>0</nuclearWarChance>
				<preventPlayerRaidPower>1</preventPlayerRaidPower>
				<languageDifficult>0.5</languageDifficult>
				<taurusInitialPower>0.5</taurusInitialPower>
			</li>
			<li Class="ProjectParagon.Settings.MiscSettings">
				<showStartInformation>true</showStartInformation>
			</li>
			<li Class="ProjectParagon.Settings.AgricultureSettings">
				<soilDepletion>0.5</soilDepletion>
				<soilRestoration>2</soilRestoration>
			</li>
			<li Class="ProjectParagon.Settings.FightSystemSettings">
				<levelingSpeed>2</levelingSpeed>
			</li>
			<li Class="ProjectParagon.Settings.ResearchSettings">
				<cultureGain>2</cultureGain>
				<spaceDataGain>2</spaceDataGain>
			</li>
			<li Class="ProjectParagon.Settings.OreSettings">
				<mineableScatterAmount>1.5</mineableScatterAmount>
				<mineableDeepAmount>1.5</mineableDeepAmount>
				<mineableDeepFrequency>1.5</mineableDeepFrequency>
			</li>
			<li Class="ProjectParagon.Settings.WorkSettings">
				<forceDropOnFloorRecipe>True</forceDropOnFloorRecipe>
				<forceIngredientSearchRadius>50</forceIngredientSearchRadius>
				<forcePassionScheduleFilter>True</forcePassionScheduleFilter>
				<forcePassionWorkEnableInSchedule>True</forcePassionWorkEnableInSchedule>
			</li>
		</settings>
	</ProjectParagon.Settings.ProjectParagonSettingsDef>
