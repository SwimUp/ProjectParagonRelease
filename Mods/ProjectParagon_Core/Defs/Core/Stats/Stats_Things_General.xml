<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<StatDef>
		<defName>CalorificValue</defName>
		<label>Calorific value</label>
		<description>The calorific value of the fuel characterizes the amount of heat released during the complete combustion of the fuel.</description>
		<category>BasicsNonPawn</category>
		<defaultBaseValue>0</defaultBaseValue>
		<hideAtValue>0</hideAtValue>
		<minValue>0</minValue>
		<toStringStyle>FloatTwo</toStringStyle>
		<showOnPawns>false</showOnPawns>
		<displayPriorityInCategory>1000</displayPriorityInCategory>
		<formatString>{0} MJ</formatString>
	</StatDef>

	<StatDef>
		<defName>BurnoutRate</defName>
		<label>Burnout rate</label>
		<description>The rate of burning out of a substance when it is used as a fuel in various buildings. The higher the value, the faster the fuel burns out and therefore the more often the fuel consumer will have to refuel. \n\nThe fuel consumer may have his own fuel utilization factor, which will affect the final value. As a rule, fuel burns faster in open sources.</description>
		<category>BasicsNonPawn</category>
		<defaultBaseValue>0</defaultBaseValue>
		<hideAtValue>0</hideAtValue>
		<minValue>0</minValue>
		<toStringStyle>FloatTwo</toStringStyle>
		<showOnPawns>false</showOnPawns>
		<displayPriorityInCategory>1000</displayPriorityInCategory>
		<formatString>{0} u/d</formatString>
	</StatDef>
	
	<StatDef>
		<defName>MaxHeatingTemperature</defName>
		<label>Max heating temperature</label>
		<description>What is the maximum room temperature that can be achieved?</description>
		<category>BasicsNonPawn</category>
		<workerClass>ProjectParagon.Core.Stats.StatWorker_MaxHeatingTemperature</workerClass>
		<defaultBaseValue>0</defaultBaseValue>
		<hideAtValue>0</hideAtValue>
		<minValue>0</minValue>
		<toStringStyle>FloatTwo</toStringStyle>
		<showOnPawns>false</showOnPawns>
		<displayPriorityInCategory>1000</displayPriorityInCategory>
		<formatString>{0} °</formatString>
	</StatDef>
	
	<StatDef>
		<defName>MaxHeatingTemperatureEfficiency</defName>
		<label>Max heating temperature efficiency</label>
		<description>Max heating temperature efficiency</description>
		<category>BasicsNonPawn</category>
		<defaultBaseValue>0</defaultBaseValue>
		<hideAtValue>0</hideAtValue>
		<minValue>0</minValue>
		<toStringStyle>FloatTwo</toStringStyle>
		<showOnPawns>false</showOnPawns>
		<displayPriorityInCategory>1000</displayPriorityInCategory>
		<formatString>{0}°</formatString>
	</StatDef>
	
	<StatDef>
		<defName>FuelConsumption</defName>
		<label>Fuel consumption</label>
		<description>Shows how efficiently the building uses fuel. The higher it is, the faster the fuel burns out. As a rule, the highest coefficients in open sources.</description>
		<category>BasicsNonPawn</category>
		<defaultBaseValue>0</defaultBaseValue>
		<hideAtValue>0</hideAtValue>
		<minValue>0</minValue>
		<toStringStyle>FloatTwo</toStringStyle>
		<showOnPawns>false</showOnPawns>
		<displayPriorityInCategory>1000</displayPriorityInCategory>
	</StatDef>
	
	<StatDef>
		<defName>HeatingEfficiency</defName>
		<label>Heating efficiency</label>
		<description>How efficiently the heat generated from the fuel is used. Heat from open sources escapes much faster than from closed sources such as stoves, fireplaces, etc.</description>
		<category>BasicsNonPawn</category>
		<defaultBaseValue>1</defaultBaseValue>
		<showIfUndefined>false</showIfUndefined>
		<minValue>0</minValue>
		<toStringStyle>PercentZero</toStringStyle>
		<showOnPawns>false</showOnPawns>
		<parts>
			<li Class="ProjectParagon.Core.Stats.StatPart_StuffHeatingEfficiency" />
		</parts>
		<displayPriorityInCategory>1000</displayPriorityInCategory>
	</StatDef>
	
	<StatDef>
		<defName>ProsthesisEfficiency</defName>
		<label>Prosthesis efficiency</label>
		<description>The parameter shows the multiplier of the material when making prosthetics from it.</description>
		<category>BasicsNonPawn</category>
		<defaultBaseValue>0</defaultBaseValue>
		<hideAtValue>0</hideAtValue>
		<minValue>0</minValue>
		<toStringStyle>PercentZero</toStringStyle>
		<showOnPawns>false</showOnPawns>
		<displayPriorityInCategory>1000</displayPriorityInCategory>
	</StatDef>
	
	<StatDef>
		<defName>BuyPriceFactor</defName>
		<label>buy price multiplier</label>
		<description>A multiplier on the price at which you can buy items.</description>
		<category>BasicsNonPawn</category>
		<showIfUndefined>false</showIfUndefined>
		<defaultBaseValue>1</defaultBaseValue>
		<minValue>0</minValue>
		<toStringStyle>PercentZero</toStringStyle>
		<displayPriorityInCategory>2509</displayPriorityInCategory>
		<showOnUntradeables>false</showOnUntradeables>
	</StatDef>

</Defs>
