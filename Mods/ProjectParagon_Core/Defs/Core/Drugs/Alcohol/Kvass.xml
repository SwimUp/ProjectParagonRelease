<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="DrugBase">
		<defName>Kvass</defName>
		<label>Kvass</label>
		<description>A refreshing drink that gives you energy and freshness.</description>
		<descriptionHyperlinks>
			<HediffDef>KvassHigh</HediffDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Core/Drugs/Kvass/Kvass</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<rotatable>false</rotatable>
		<stackLimit>25</stackLimit>
		<statBases>
			<DeteriorationRate>0.5</DeteriorationRate>
			<MarketValue>3</MarketValue>
			<Mass>0.3</Mass>
			<Flammability>0.5</Flammability>
			<Nutrition>0.1</Nutrition>
			<Protein>0.001</Protein>
			<Fat>0.005</Fat>
			<Carbohydrates>0.015</Carbohydrates>
			<Vitamins>0.010</Vitamins>
			<Flavor>1</Flavor>
		</statBases>
		<ingestible>
			<foodType>Fluid, Processed, Liquor</foodType>
			<joyKind>Gluttonous</joyKind>
			<joy>0.05</joy>
			<nurseable>true</nurseable>
			<drugCategory>Social</drugCategory>
			<ingestSound>Ingest_Beer</ingestSound>
			<ingestHoldOffsetStanding>
				<northDefault>
					<offset>(0.18,0,0)</offset>
				</northDefault>
			</ingestHoldOffsetStanding>
			<ingestCommandString>Drink {0}</ingestCommandString>
			<ingestReportString>Drinking {0}.</ingestReportString>
			<chairSearchRadius>25</chairSearchRadius>
			<canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>KvassHigh</hediffDef>
					<severity>0.5</severity>
					<toleranceChemical>Alcohol</toleranceChemical>
				</li>
			</outcomeDoers>
		</ingestible>
		<techLevel>Neolithic</techLevel>
		<comps>
			<li Class="CompProperties_Drug">
				<listOrder>1000</listOrder>
				<overdoseSeverityOffset>0.08~0.14</overdoseSeverityOffset>
			</li>
		</comps>
	</ThingDef>
	<RecipeDef Class="ProjectParagon.Core.Recipes.ExtendedRecipeDef">
		<defName>Make_KvassWort</defName>
		<label>Make kvass wort</label>
		<description>Prepare wort for kvass production.</description>
		<jobString>Making kvass wort.</jobString>
		<workSpeedStat>DrugCookingSpeed</workSpeedStat>
		<workSkill>Cooking</workSkill>
		<effectWorking>Cook</effectWorking>
		<soundWorking>Recipe_Brewing</soundWorking>
		<allowMixingIngredients>true</allowMixingIngredients>
		<workAmount>1000</workAmount>
		<targetCountAdjustment>1</targetCountAdjustment>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>WhiteBread</li>
						<li>BlackBread</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Sugar</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<abstractIngredients>
			<li Class="ProjectParagon.Core.Recipes.IngredientCountParagon_Water">
				<count>5</count>
			</li>
		</abstractIngredients>
		<products>
			<KvassWort>5</KvassWort>
		</products>
		<researchPrerequisite>CookingII</researchPrerequisite>
		<fixedIngredientFilter>
			<thingDefs>
				<li>WhiteBread</li>
				<li>BlackBread</li>
				<li>Sugar</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>WhiteBread</li>
				<li>BlackBread</li>
				<li>Sugar</li>
			</thingDefs>
		</defaultIngredientFilter>
		<recipeUsers>
			<li>Brewery</li>
		</recipeUsers>
	</RecipeDef>
	<ThingDef ParentName="ResourceBase">
		<defName>KvassWort</defName>
		<label>Kvass wort</label>
		<description>Tincture for the fermentation of kvass.</description>
		<graphicData>
			<texPath>Core/Drugs/Kvass/WortKvass</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<healthAffectsPrice>false</healthAffectsPrice>
		<rotatable>false</rotatable>
		<stackLimit>25</stackLimit>
		<thingCategories>
			<li>Wort</li>
		</thingCategories>
		<statBases>
			<DeteriorationRate>1.0</DeteriorationRate>
			<MarketValue>1</MarketValue>
			<Mass>0.5</Mass>
			<Flammability>0.3</Flammability>
			<MaxHitPoints>50</MaxHitPoints>
		</statBases>
		<tickerType>Rare</tickerType>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>7</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>
	<HediffDef>
		<defName>KvassHigh</defName>
		<label>Kvass impact</label>
		<labelNoun>a kvass impact</labelNoun>
		<description>Kvass impact.</description>
		<hediffClass>Hediff_High</hediffClass>
		<defaultLabelColor>(0.5, 1.0, 0.0)</defaultLabelColor>
		<scenarioCanAdd>true</scenarioCanAdd>
		<maxSeverity>1.0</maxSeverity>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-1</severityPerDay>
				<showHoursToRecover>true</showHoursToRecover>
			</li>
		</comps>
		<stages>
			<li>
				<label>easy</label>
				<statOffsets>
					<ComfyTemperatureMax>3</ComfyTemperatureMax>
				</statOffsets>
			</li>
			<li>
				<label>medium</label>
				<minSeverity>0.5</minSeverity>
				<statOffsets>
					<ComfyTemperatureMax>5</ComfyTemperatureMax>
				</statOffsets>
			</li>
			<li>
				<label>severe</label>
				<minSeverity>0.8</minSeverity>
				<statOffsets>
					<ComfyTemperatureMax>10</ComfyTemperatureMax>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>
	<ThoughtDef>
		<defName>KvassHigh</defName>
		<workerClass>ThoughtWorker_Hediff</workerClass>
		<hediff>KvassHigh</hediff>
		<validWhileDespawned>true</validWhileDespawned>
		<stages>
			<li>
				<label>high on kvass</label>
				<description>I feel so energetic!</description>
				<baseMoodEffect>5</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
</Defs>