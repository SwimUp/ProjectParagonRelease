<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>MechanoidQuality</defName>
		<label>Mechanoid quality</label>
		<description>Reflects the quality of the mechanoid and affects the performance characteristics.</description>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>6</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<stages>
			<li>
				<label>awful</label>
				<statFactors>
					<WorkSpeedGlobal>0.5</WorkSpeedGlobal>
					<MoveSpeed>0.5</MoveSpeed>
					<MechEnergyUsageFactor>2</MechEnergyUsageFactor>
				</statFactors>
			</li>
			<li>
				<label>poor</label>
				<minSeverity>1</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>0.75</WorkSpeedGlobal>
					<MoveSpeed>0.75</MoveSpeed>
					<MechEnergyUsageFactor>1.5</MechEnergyUsageFactor>
				</statFactors>
			</li>
			<li>
				<label>normal</label>
				<minSeverity>2</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1</WorkSpeedGlobal>
					<MoveSpeed>1</MoveSpeed>
					<MechEnergyUsageFactor>1</MechEnergyUsageFactor>
				</statFactors>
			</li>
			<li>
				<label>good</label>
				<minSeverity>3</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1.1</WorkSpeedGlobal>
					<MoveSpeed>1.1</MoveSpeed>
					<MechEnergyUsageFactor>0.9</MechEnergyUsageFactor>
				</statFactors>
			</li>
			<li>
				<label>excellent</label>
				<minSeverity>4</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1.25</WorkSpeedGlobal>
					<MoveSpeed>1.25</MoveSpeed>
					<MechEnergyUsageFactor>0.8</MechEnergyUsageFactor>
				</statFactors>
			</li>
			<li>
				<label>masterwork</label>
				<minSeverity>5</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1.5</WorkSpeedGlobal>
					<MoveSpeed>1.5</MoveSpeed>
					<MechEnergyUsageFactor>0.7</MechEnergyUsageFactor>
				</statFactors>
			</li>
			<li>
				<label>legendary</label>
				<minSeverity>6</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>2</WorkSpeedGlobal>
					<MoveSpeed>2</MoveSpeed>
					<MechEnergyUsageFactor>0.5</MechEnergyUsageFactor>
				</statFactors>
			</li>
		</stages>
	</HediffDef>
	<!---->
</Defs>
