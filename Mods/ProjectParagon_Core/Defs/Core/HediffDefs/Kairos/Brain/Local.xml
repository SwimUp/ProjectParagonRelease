<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<HediffDef>
		<defName>HediffDef_GroupIntelligence</defName>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_GroupIntelligence</hediffClass>
		<label>Group intelligence</label>
		<description>Kairos Princes are able to transmit information through biological organs that form wave vibrations. The more Kairos Princes on the map, the more effective they are.</description>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<isBad>false</isBad>
		<priceImpact>true</priceImpact>
		<initialSeverity>1</initialSeverity>
		<minSeverity>0</minSeverity>
		<maxSeverity>6</maxSeverity>
		<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<stages>
			<li>
				<minSeverity>1</minSeverity>
				<statFactors>
					<PsychicSensitivity>1</PsychicSensitivity>
					<ResearchSpeed>1</ResearchSpeed>
				</statFactors>
			</li>
			<li>
				<minSeverity>2</minSeverity>
				<statFactors>
					<PsychicSensitivity>1.05</PsychicSensitivity>
					<ResearchSpeed>1.1</ResearchSpeed>
				</statFactors>
			</li>
			<li>
				<minSeverity>3</minSeverity>
				<statFactors>
					<PsychicSensitivity>1.1</PsychicSensitivity>
					<ResearchSpeed>1.2</ResearchSpeed>
				</statFactors>
			</li>
			<li>
				<minSeverity>4</minSeverity>
				<statFactors>
					<PsychicSensitivity>1.15</PsychicSensitivity>
					<ResearchSpeed>1.3</ResearchSpeed>
				</statFactors>
			</li>
			<li>
				<minSeverity>5</minSeverity>
				<statFactors>
					<PsychicSensitivity>1.2</PsychicSensitivity>
					<ResearchSpeed>1.4</ResearchSpeed>
				</statFactors>
			</li>
			<li>
				<minSeverity>6</minSeverity>
				<statFactors>
					<PsychicSensitivity>1.25</PsychicSensitivity>
					<ResearchSpeed>1.5</ResearchSpeed>
				</statFactors>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef>
		<defName>ArixGland</defName>
		<label>Arix's gland</label>
		<description>An organ located deep in the brain. Injects hormones into the creature’s blood, which allows it to quickly gain speed in life-threatening circumstances. Activated when suppressed.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_ArixGland</hediffClass>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
		<chronic>true</chronic>
		<stages>
			<li>
				<label>normal</label>
			</li>
			<li>
				<label>suppressed</label>
				<minSeverity>1</minSeverity>
				<statFactors>
					<MoveSpeed>1.5</MoveSpeed>
				</statFactors>
				<capMods>
					<li>
						<capacity>Breathing</capacity>
						<offset>0.25</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef>
		<defName>DesertMetabolism</defName>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_DesertMetabolism</hediffClass>
		<label>Desert metabolism</label>
		<description>Desert metabolism</description>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<isBad>false</isBad>
		<priceImpact>true</priceImpact>
		<initialSeverity>0.001</initialSeverity>
		<minSeverity>0.001</minSeverity>
		<maxSeverity>1</maxSeverity>
		<keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
		<stages>
			<li>
				<label>not active</label>
				<capMods>
					<li>
						<capacity>Metabolism</capacity>
						<setMax>0.9</setMax>
					</li>
				</capMods>
			</li>
			<li>
				<label>active</label>
				<minSeverity>1</minSeverity>
				<capMods>
					<li>
						<capacity>Metabolism</capacity>
						<offset>0.5</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
	<!---->
</Defs>
