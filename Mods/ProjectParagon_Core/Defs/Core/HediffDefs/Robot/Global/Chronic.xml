<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>Robot</defName>
		<label>Robot</label>
		<description>This mechanical creature cannot feel pain.</description>
		<initialSeverity>1.0</initialSeverity>
		<maxSeverity>1.0</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<stages>
			<li>
				<painFactor>0</painFactor>
				<naturalHealingFactor>0.5</naturalHealingFactor>
				<foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
				<fertilityFactor>0</fertilityFactor>
				<statFactors>
					<PsychicSensitivity>0</PsychicSensitivity>
				</statFactors>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>RobotStalin</defName>
		<label>Robot «Iosif Stalin»</label>
		<description>A monstrous creature made of metal, dressed in a stylish coat.</description>
		<initialSeverity>1.0</initialSeverity>
		<maxSeverity>1.0</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<stages>
			<li>
			
				<painFactor>0</painFactor>
				<naturalHealingFactor>5</naturalHealingFactor>
				<foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
				<fertilityFactor>0</fertilityFactor>
				<statFactors>
					<PsychicSensitivity>0</PsychicSensitivity>
					<MeleeHitChance>1.5</MeleeHitChance>
					<SocialImpact>0</SocialImpact>
					<MeleeDamageFactor>3</MeleeDamageFactor>
					<IncomingDamageFactor>0.75</IncomingDamageFactor>
				</statFactors>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>2.0</postFactor>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>RobotQuality</defName>
		<label>Robot quality</label>
		<description>Reflects the quality of the mechanoid and affects the performance characteristics.</description>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>6</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<stages>
			<li>
				<label>awful</label>
				<statFactors>
					<WorkSpeedGlobal>0.5</WorkSpeedGlobal>
					<MoveSpeed>0.5</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<label>poor</label>
				<minSeverity>1</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>0.75</WorkSpeedGlobal>
					<MoveSpeed>0.75</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<label>normal</label>
				<minSeverity>2</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1</WorkSpeedGlobal>
					<MoveSpeed>1</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<label>good</label>
				<minSeverity>3</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1.05</WorkSpeedGlobal>
					<MoveSpeed>1.05</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<label>excellent</label>
				<minSeverity>4</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1.1</WorkSpeedGlobal>
					<MoveSpeed>1.1</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<label>masterwork</label>
				<minSeverity>5</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1.25</WorkSpeedGlobal>
					<MoveSpeed>1.25</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<label>legendary</label>
				<minSeverity>6</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>1.5</WorkSpeedGlobal>
					<MoveSpeed>1.5</MoveSpeed>
				</statFactors>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>RobotStuff</defName>
		<label>Robot stuff</label>
		<description>Reflects the characteristics of the material from which the robot is made.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_RobotStuff</hediffClass>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>6</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
	</HediffDef>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>RobotConnect</defName>
		<label>Robot connect</label>
		<description>robot communication with AI nodes.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_RobotConnect</hediffClass>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>2</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<stages>
			<li>
				<label>hidden</label>
				<becomeVisible>false</becomeVisible>
			</li>
			<li>
				<label>disconnected</label>
				<minSeverity>1</minSeverity>
				<statFactors>
					<WorkSpeedGlobal>0.5</WorkSpeedGlobal>
					<GlobalLearningFactor>0</GlobalLearningFactor>
				</statFactors>
			</li>
			<li>
				<label>connected</label>
				<minSeverity>2</minSeverity>
			</li>
		</stages>
	</HediffDef>
	<!---->
</Defs>
