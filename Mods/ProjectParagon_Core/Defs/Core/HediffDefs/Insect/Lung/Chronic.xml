<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<HediffDef>
		<defName>LargorOrgan</defName>
		<label>Largor's organ</label>
		<description>A special organ connected to the nervous system. Enhances muscle responses during stress. It was first discovered by xenobiologist Largor during the dissection of a megarachnid.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_LargorOrgan</hediffClass>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>4</maxSeverity>
		<countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
		<chronic>true</chronic>
		<stages>
			<li>
				<!-- нормальное настроение -->
				<label>normal</label>
			</li>
			<li>
				<!-- риск легкого срыва -->
				<label>nervousness</label>
				<minSeverity>1</minSeverity>
				<statFactors>
					<MoveSpeed>1.05</MoveSpeed>
				</statFactors>
				<capMods>
					<li>
						<capacity>Breathing</capacity>
						<offset>0.05</offset>
					</li>
				</capMods>
			</li>
			<li>
				<!-- риск тяжелого срыва -->
				<label>stress</label>
				<minSeverity>2</minSeverity>
				<statFactors>
					<MoveSpeed>1.1</MoveSpeed>
				</statFactors>
				<capMods>
					<li>
						<capacity>Breathing</capacity>
						<offset>0.1</offset>
					</li>
				</capMods>
			</li>
			<li>
				<!-- риск экстремального срыва -->
				<label>aggression</label>
				<minSeverity>3</minSeverity>
				<statFactors>
					<MoveSpeed>1.15</MoveSpeed>
				</statFactors>
				<capMods>
					<li>
						<capacity>Breathing</capacity>
						<offset>0.15</offset>
					</li>
				</capMods>
			</li>
			<li>
				<!-- в срыве -->
				<label>rage</label>
				<minSeverity>4</minSeverity>
				<statFactors>
					<MoveSpeed>1.25</MoveSpeed>
				</statFactors>
				<capMods>
					<li>
						<capacity>Breathing</capacity>
						<offset>0.25</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
	<!---->
</Defs>
