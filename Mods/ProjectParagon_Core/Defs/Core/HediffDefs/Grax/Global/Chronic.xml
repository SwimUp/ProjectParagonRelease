<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>Grax</defName>
		<label>Grax</label>
		<description>Representative of flint life.</description>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<initialSeverity>1</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<stages>
			<li>
				<painFactor>0</painFactor>
				<fertilityFactor>0</fertilityFactor>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>ThermalMetabolism</defName>
		<label>Thermal metabolism</label>
		<description>The creature is capable of replacing solar energy for life using heat from geothermal sources or other heat sources.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_ThermalMetabolism</hediffClass>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<initialSeverity>1</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<stages>
			<li>
				<label>cold</label>
			</li>
			<li>
				<label>frosty</label>
				<minSeverity>0.2</minSeverity>
			</li>
			<li>
				<label>normal</label>
				<minSeverity>0.4</minSeverity>
			</li>
			<li>
				<label>warm</label>
				<minSeverity>0.6</minSeverity>
			</li>
			<li>
				<label>hot</label>
				<minSeverity>0.8</minSeverity>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>GraxSkin</defName>
		<label>stone skin</label>
		<description>The creature is covered in rocks that protect it from blows.</description>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<initialSeverity>0.001</initialSeverity>
		<minSeverity>0.0001</minSeverity>
		<maxSeverity>4.0</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<stages>
			<li>
				<label>marble</label>
				<minSeverity>0</minSeverity>
				<statOffsets>
					<ArmorRating_Sharp>2</ArmorRating_Sharp>
					<ArmorRating_Blunt>5</ArmorRating_Blunt>
				</statOffsets>
			</li>
			<li>
				<label>slate</label>
				<minSeverity>1</minSeverity>
				<statOffsets>
					<ArmorRating_Sharp>3</ArmorRating_Sharp>
					<ArmorRating_Blunt>7</ArmorRating_Blunt>
				</statOffsets>
			</li>
			<li>
				<label>sandstone</label>
				<minSeverity>2</minSeverity>
				<statOffsets>
					<ArmorRating_Sharp>4</ArmorRating_Sharp>
					<ArmorRating_Blunt>9</ArmorRating_Blunt>
				</statOffsets>
			</li>
			<li>
				<label>limestone</label>
				<minSeverity>3</minSeverity>
				<statOffsets>
					<ArmorRating_Sharp>5</ArmorRating_Sharp>
					<ArmorRating_Blunt>12</ArmorRating_Blunt>
				</statOffsets>
			</li>
			<li>
				<label>granite</label>
				<minSeverity>4</minSeverity>
				<statOffsets>
					<ArmorRating_Sharp>6</ArmorRating_Sharp>
					<ArmorRating_Blunt>15</ArmorRating_Blunt>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>
	<!---->
</Defs>
