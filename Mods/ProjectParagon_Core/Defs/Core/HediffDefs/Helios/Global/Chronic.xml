<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>SubstitutionFlesh</defName>
		<label>Substitution of flesh</label>
		<description>The gradual process of replacing flesh with living metal.</description>
		<makesSickThought>false</makesSickThought>
		<minSeverity>0.001</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1.0</maxSeverity>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>2</severityPerDay>
			</li>
		</comps>
		<stages>
			<li>
				<label>substitution</label>
				<partEfficiencyOffset>-0.9</partEfficiencyOffset>
				<painOffset>0.04</painOffset>
			</li>
			<li>
				<label>growth</label>
				<minSeverity>0.2</minSeverity>
				<partEfficiencyOffset>-0.5</partEfficiencyOffset>
				<painOffset>0.02</painOffset>
			</li>
			<li>
				<label>replaced</label>
				<minSeverity>0.99</minSeverity>
				<partEfficiencyOffset>-0.2</partEfficiencyOffset>
			</li>
		</stages>
	</HediffDef>
	<!---->
</Defs>
