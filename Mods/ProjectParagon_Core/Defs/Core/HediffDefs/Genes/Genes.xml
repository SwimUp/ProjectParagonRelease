<Defs>
	<!---->
	<HediffDef>
		<defName>LackOfSun</defName>
		<label>Lack of sun</label>
		<description>The lack of sun for this creature is deadly.</description>
		<lethalSeverity>1</lethalSeverity>
		<stages>
			<li>
				<label>trivial</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.95</setMax>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.2</minSeverity>
				<label>minor</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.9</setMax>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.4</minSeverity>
				<label>moderate</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.8</setMax>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.6</minSeverity>
				<label>severe</label>
				<lifeThreatening>true</lifeThreatening>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.5</setMax>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.8</minSeverity>
				<label>extreme</label>
				<lifeThreatening>true</lifeThreatening>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef>
		<defName>SymbioticParasite</defName>
		<label>Symbiotic parasite</label>
		<description>A plant parasite that sucks energy from the host to grow fruits.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_SymbioticParasite</hediffClass>
		<initialSeverity>0.001</initialSeverity>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<maxSeverity>1</maxSeverity>
		<countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
		<makesSickThought>true</makesSickThought>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.5</setMax>
					</li>
				</capMods>
			</li>
		</stages>
		<chronic>true</chronic>
	</HediffDef>
