<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<HediffDef>
		<defName>Conzius</defName>
		<label>Conzius</label>
		<description>A brain nutrition system that allows a creature to stay awake without interruption for sleep as long as there are enough carbohydrates and vitamins in the body.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_Conzius</hediffClass>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<isBad>false</isBad>
		<priceImpact>true</priceImpact>
		<initialSeverity>0.001</initialSeverity>
		<minSeverity>0.001</minSeverity>
		<maxSeverity>1</maxSeverity>
		<keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
		<stages>
			<li>
				<label>not active</label>
			</li>
			<li>
				<label>active</label>
				<minSeverity>1</minSeverity>
				<restFallFactor>0</restFallFactor>
				<statFactors>
					<Food_VitaminsFactor>1.15</Food_VitaminsFactor>
					<Food_CarbohydratesFactor>1.15</Food_CarbohydratesFactor>
				</statFactors>
			</li>
		</stages>
	</HediffDef>
	<!---->
</Defs>
