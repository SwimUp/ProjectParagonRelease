<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<HediffDef ParentName="ChronicDiseaseBase">
		<defName>AeronArmor</defName>
		<label>Aeron armor</label>
		<description>The main component of Aeron armor. Requires periodic change, leaving the owner defenseless.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_AeronArmor</hediffClass>
		<initialSeverity>0.001</initialSeverity>
		<minSeverity>0.0001</minSeverity>
		<maxSeverity>1</maxSeverity>
		<tendable>false</tendable>
		<makesSickThought>false</makesSickThought>
		<isBad>false</isBad>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>0.0667</severityPerDay>
			</li>
		</comps>
		<stages>
			<li>
				<label>absent</label>
			</li>
			<li>
				<minSeverity>0.3</minSeverity>
				<label>growing</label>
				<statOffsets>
					<ArmorRating_Blunt>1</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.5</ArmorRating_Sharp>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.75</minSeverity>
				<label>finished</label>
				<statOffsets>
					<ArmorRating_Blunt>3</ArmorRating_Blunt>
					<ArmorRating_Sharp>2</ArmorRating_Sharp>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef>
		<defName>VitrisGlands</defName>
		<label>Vitris glands</label>
		<description>Small round glands located at the joints of the shell. Uranium derivatives are isolated. First discovered by xenobiologist Vitris.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<initialSeverity>0.001</initialSeverity>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<maxSeverity>1</maxSeverity>
		<countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
		<chronic>true</chronic>
		<comps>
			<li Class="ProjectParagon.Core.Genes.HediffCompProperties_ItemProducer">
				<thingDef>UraniumPowder</thingDef>
				<dayDuration>2</dayDuration>
				<countRange>8</countRange>
			</li>
		</comps>
	</HediffDef>
	<!---->
	<HediffDef>
		<defName>ControlledCellDivision</defName>
		<label>Controlled cell division</label>
		<description>Artificial acceleration of cell division, possible due to increased protein consumption. Helps quickly recover from injuries, but increases the risk of cancer.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_ControlledCellDivision</hediffClass>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<isBad>false</isBad>
		<priceImpact>true</priceImpact>
		<initialSeverity>0.001</initialSeverity>
		<minSeverity>0.001</minSeverity>
		<maxSeverity>1</maxSeverity>
		<keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
		<chronic>true</chronic>
		<stages>
			<li>
				<label>not active</label>
			</li>
			<li>
				<label>active</label>
				<minSeverity>1</minSeverity>
				<statFactors>
					<Food_ProteinFactor>1.15</Food_ProteinFactor>
					<CancerRate>5</CancerRate>
				</statFactors>
				<regeneration>20</regeneration>
			</li>
		</stages>
	</HediffDef>
	<!---->
	<HediffDef>
		<defName>AblativeChitinPlates</defName>
		<label>Ablative chitin plates</label>
		<description>Durable growths on the shell that are able to reflect the damage received and then fall off. The growth of the plates depends on the overall regeneration rate of the creature.</description>
		<hediffClass>ProjectParagon.Core.Hediffs.Hediff_AblativeChitinPlates</hediffClass>
		<defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
		<isBad>false</isBad>
		<priceImpact>true</priceImpact>
		<initialSeverity>0.001</initialSeverity>
		<minSeverity>0.001</minSeverity>
		<maxSeverity>1</maxSeverity>
		<chronic>true</chronic>
		<keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
		<stages>
			<li>
				<minSeverity>0</minSeverity>
			</li>
			<li>
				<minSeverity>0.1</minSeverity>
				<statOffsets>
					<ArmorRating_Blunt>0.75</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.5</ArmorRating_Sharp>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.25</minSeverity>
				<statOffsets>
					<ArmorRating_Blunt>1.25</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.85</ArmorRating_Sharp>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.5</minSeverity>
				<statOffsets>
					<ArmorRating_Blunt>1.75</ArmorRating_Blunt>
					<ArmorRating_Sharp>1.25</ArmorRating_Sharp>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.75</minSeverity>
				<statOffsets>
					<ArmorRating_Blunt>3</ArmorRating_Blunt>
					<ArmorRating_Sharp>2</ArmorRating_Sharp>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.9</minSeverity>
				<statOffsets>
					<ArmorRating_Blunt>4</ArmorRating_Blunt>
					<ArmorRating_Sharp>3</ArmorRating_Sharp>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>
	<!---->
</Defs>
