<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<GeneDef Name="GeneMemoryBase" Abstract="True">
		<displayCategory>Learning</displayCategory>
		<exclusionTags>
			<li>Memory</li>
		</exclusionTags>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneMemoryBase">
		<defName>Memory_Terrible</defName>
		<label>Terrible memory</label>
		<description>The carrier of the gene has great difficulty retaining new information in his head.</description>
		<iconPath>Core/Genes/Memory_Terrible</iconPath>
		<displayOrderInCategory>10</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>2</biostatMet>
		<forcedTraits>
			<li>
				<def>TerribleMemory</def>
			</li>
		</forcedTraits>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneMemoryBase">
		<defName>Memory_Poor</defName>
		<label>Poor memory</label>
		<description>The carrier of the gene has difficulty retaining new information in his head.</description>
		<iconPath>Core/Genes/Memory_Poor</iconPath>
		<displayOrderInCategory>20</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<forcedTraits>
			<li>
				<def>PoorMemory</def>
			</li>
		</forcedTraits>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneMemoryBase">
		<defName>Memory_GreatMemory</defName>
		<label>Great memory</label>
		<description>The carrier of the gene better assimilates the information received.</description>
		<iconPath>Core/Genes/Memory_GreatMemory</iconPath>
		<displayOrderInCategory>30</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<forcedTraits>
			<li>
				<def>GreatMemory</def>
			</li>
		</forcedTraits>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneMemoryBase">
		<defName>Memory_PerfectMemory</defName>
		<label>Perfect memory</label>
		<description>The carrier of the gene does not forget anything.</description>
		<iconPath>Core/Genes/Memory_PerfectMemory</iconPath>
		<displayOrderInCategory>40</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-3</biostatMet>
		<forcedTraits>
			<li>
				<def>PerfectMemory</def>
			</li>
		</forcedTraits>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneLearningBase">
		<defName>Learning_Ineducable</defName>
		<label>Ineducable</label>
		<description>The carrier of the gene is simply not capable of learning. He does not assimilate new information, and his brain seems to have turned to stone.</description>
		<iconPath>Core/Genes/Ineducable</iconPath>
		<displayOrderInCategory>50</displayOrderInCategory>
		<statFactors>
			<GlobalLearningFactor>0</GlobalLearningFactor>
		</statFactors>
		<biostatMet>6</biostatMet>
		<displayCategory>Learning</displayCategory>
		<symbolPack>
			<prefixSymbols>
				<li>
					<symbol>thag</symbol>
				</li>
				<li>
					<symbol>grunt</symbol>
				</li>
				<li>
					<symbol>slow</symbol>
				</li>
				<li>
					<symbol>dull</symbol>
				</li>
				<li>
					<symbol>dumb</symbol>
				</li>
			</prefixSymbols>
			<suffixSymbols>
				<li>
					<symbol>grunt</symbol>
				</li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>
	<!---->
</Defs>
