<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<GeneDef Name="GeneAeroniumBase" Abstract="True">
		<displayCategory>Aeronium</displayCategory>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium</defName>
		<label>Aeronium</label>
		<description>Genetically modified kairos, given additional organs and capabilities. The Aeroniums embodied the idea of ​​speed by strengthening the lungs to power modified muscles. They skillfully use the capabilities of their body to successfully survive in the desert.</description>
		<iconPath>Core/Genes/Aeronium</iconPath>
		<displayOrderInCategory>0</displayOrderInCategory>
		<biostatCpx>5</biostatCpx>
		<biostatMet>4</biostatMet>
		<exclusionTags>
			<li>GeneticEngineering</li>
		</exclusionTags>
		<capMods>
			<li>
				<capacity>Consciousness</capacity>
				<offset>0.15</offset>
			</li>
		</capMods>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_Hartix</defName>
		<label>Hartix</label>
		<description>A fairly large organ located in the digestive system. Helps to better absorb proteins and fats in food.</description>
		<iconPath>Core/Genes/Aeronium_Hartix</iconPath>
		<displayOrderInCategory>10</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>Aeronium</prerequisite>
		<statFactors>
			<Food_ProteinFactorDigestibility>1.25</Food_ProteinFactorDigestibility>
			<Food_FatFactorDigestibility>1.25</Food_FatFactorDigestibility>
		</statFactors>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_FusedShell</defName>
		<label>Fused shell</label>
		<description>The shell becomes permanent for the creature. Aeronium does not need to regularly update it, remaining defenseless. In addition, this significantly saves vitamins and minerals, which are no longer spent on the growth of a new shell.</description>
		<iconPath>Core/Genes/Aeronium_FusedShell</iconPath>
		<displayOrderInCategory>20</displayOrderInCategory>
		<biostatCpx>2</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>Aeronium</prerequisite>
		<statFactors>
			<Food_VitaminsFactor>0.75</Food_VitaminsFactor>
		</statFactors>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_GrowingLimbs</defName>
		<label>Growing limbs</label>
		<description>Aeroniums are able to regrow lost limbs over time.</description>
		<geneClass>ProjectParagon.Core.Genes.Gene_GrowingLimbs</geneClass>
		<iconPath>Core/Genes/Aeronium_GrowingLimbs</iconPath>
		<displayOrderInCategory>30</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>Aeronium</prerequisite>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_Merix</defName>
		<label>Merix</label>
		<description>Numerous neural centers located throughout the body. They help to slightly increase mental abilities.</description>
		<iconPath>Core/Genes/Aeronium_Merix</iconPath>
		<displayOrderInCategory>40</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>Aeronium</prerequisite>
		<statFactors>
			<WorkSpeedGlobal>1.1</WorkSpeedGlobal>
		</statFactors>
		<capMods>
			<li>
				<capacity>Consciousness</capacity>
				<offset>0.05</offset>
			</li>
		</capMods>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_Conzius</defName>
		<label>Conzius</label>
		<description>A brain nutrition system that allows a creature to stay awake without interruption for sleep as long as there are enough carbohydrates and vitamins in the body.</description>
		<geneClass>ProjectParagon.Core.Genes.Gene_ForceHediff</geneClass>
		<iconPath>Core/Genes/Aeronium_Conzius</iconPath>
		<displayOrderInCategory>50</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<prerequisite>Aeronium</prerequisite>
		<exclusionTags>
			<li>Vitamins</li>
			<li>Carbohydrates</li>
		</exclusionTags>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<props Class="ProjectParagon.Core.Genes.GeneProperties_ForceHediff">
					<hediffDef>Conzius</hediffDef>
					<canAffectAnyLivePart>true</canAffectAnyLivePart>
					<severity>1</severity>
					<count>1</count>
					<bodyParts>
						<li>Brain</li>
					</bodyParts>
				</props>
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_VitrisGlands</defName>
		<label>Vitris glands</label>
		<description>Small round glands located at the joints of the shell. Uranium derivatives are isolated. First discovered by xenobiologist Vitris.</description>
		<geneClass>ProjectParagon.Core.Genes.Gene_ForceHediff</geneClass>
		<iconPath>Core/Genes/Aeronium_VitrisGlands</iconPath>
		<displayOrderInCategory>60</displayOrderInCategory>
		<biostatCpx>3</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>Aeronium</prerequisite>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<props Class="ProjectParagon.Core.Genes.GeneProperties_ForceHediff">
					<hediffDef>VitrisGlands</hediffDef>
					<severity>0.001</severity>
					<canAffectAnyLivePart>false</canAffectAnyLivePart>
				</props>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_Firtus</defName>
		<label>Firtus</label>
		<description>Small organs that supplement the filtering function of the kidneys. In cross-section, hundreds of small tubular segments can be seen.</description>
		<iconPath>Core/Genes/Aeronium_Firtus</iconPath>
		<displayOrderInCategory>70</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<prerequisite>Aeronium</prerequisite>
		<capMods>
			<li>
				<capacity>BloodFiltration</capacity>
				<offset>0.5</offset>
			</li>
		</capMods>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_ControlledCellDivision</defName>
		<label>Controlled cell division</label>
		<description>Artificial acceleration of cell division, possible due to increased protein consumption. Helps quickly recover from injuries, but increases the risk of cancer.</description>
		<geneClass>ProjectParagon.Core.Genes.Gene_ForceHediff</geneClass>
		<iconPath>Core/Genes/Aeronium_ControlledCellDivision</iconPath>
		<displayOrderInCategory>80</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-2</biostatMet>
		<prerequisite>Aeronium</prerequisite>
		<exclusionTags>
			<li>CellInstability</li>
		</exclusionTags>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<props Class="ProjectParagon.Core.Genes.GeneProperties_ForceHediff">
					<hediffDef>ControlledCellDivision</hediffDef>
					<severity>0.001</severity>
					<canAffectAnyLivePart>false</canAffectAnyLivePart>
				</props>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneAeroniumBase">
		<defName>Aeronium_AblativeChitinPlates</defName>
		<label>Ablative chitin plates</label>
		<description>Durable growths on the shell that are able to reflect the damage received and then fall off. The growth of the plates depends on the overall regeneration rate of the creature.</description>
		<geneClass>ProjectParagon.Core.Genes.Gene_ForceHediff</geneClass>
		<iconPath>Core/Genes/Aeronium_AblativeChitinPlates</iconPath>
		<displayOrderInCategory>90</displayOrderInCategory>
		<biostatCpx>2</biostatCpx>
		<biostatMet>-2</biostatMet>
		<prerequisite>Aeronium_FusedShell</prerequisite>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<props Class="ProjectParagon.Core.Genes.GeneProperties_ForceHediff">
					<hediffDef>AblativeChitinPlates</hediffDef>
					<canAffectAnyLivePart>false</canAffectAnyLivePart>
					<severity>1</severity>
					<count>1</count>
				</props>
				<relatedRaces>
					<li>AeronRace</li>
					<li>AeronixRace</li>
					<li>AeronesRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
</Defs>