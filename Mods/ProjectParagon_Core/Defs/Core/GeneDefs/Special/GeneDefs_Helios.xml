<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<GeneDef Name="GeneHeliosBase" Abstract="True">
		<displayCategory>Helios</displayCategory>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios</defName>
		<label>Helios</label>
		<description>A special type of genetically modified people created using genetic engineering in sterile laboratory conditions.</description>
		<iconPath>Core/Genes/Helios</iconPath>
		<displayOrderInCategory>0</displayOrderInCategory>
		<biostatCpx>5</biostatCpx>
		<biostatMet>2</biostatMet>
		<exclusionTags>
			<li>GeneticEngineering</li>
		</exclusionTags>
		<capMods>
			<li>
				<capacity>Consciousness</capacity>
				<offset>0.15</offset>
			</li>
		</capMods>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_Halitius</defName>
		<label>Halitius</label>
		<description>An additional organ located under the lungs that supplements them, increasing the efficiency of oxygen absorption.</description>
		<iconPath>Core/Genes/Helios_Halitius</iconPath>
		<displayOrderInCategory>10</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<prerequisite>Helios</prerequisite>
		<capMods>
			<li>
				<capacity>Breathing</capacity>
				<offset>0.25</offset>
			</li>
		</capMods>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_Margnirus</defName>
		<label>Margnirus</label>
		<description>An additional organ located in the larynx. Allows you to change the volume of your voice and even imitate someone else's.</description>
		<iconPath>Core/Genes/Helios_Margnirus</iconPath>
		<displayOrderInCategory>20</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<prerequisite>Helios</prerequisite>
		<capMods>
			<li>
				<capacity>Talking</capacity>
				<offset>0.25</offset>
			</li>
		</capMods>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_VeneumGland</defName>
		<label>Veneum gland</label>
		<description>An additional organ built into the esophagus. Improves digestion and allows you to filter some of the toxins in food.</description>
		<iconPath>Core/Genes/Helios_VeneumGland</iconPath>
		<displayOrderInCategory>30</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<prerequisite>Helios</prerequisite>
		<capMods>
			<li>
				<capacity>Eating</capacity>
				<offset>0.25</offset>
			</li>
			<li>
				<capacity>BloodFiltration</capacity>
				<offset>0.05</offset>
			</li>
		</capMods>
		<foodPoisoningChanceFactor>0.5</foodPoisoningChanceFactor>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_Venefictus</defName>
		<label>Venefictus</label>
		<description>Accessory organ distributed in the salivary glands. Enhances the secretion of acid and increases the level of its activity, which increases the digestibility of food.</description>
		<iconPath>Core/Genes/Helios_Venefictus</iconPath>
		<displayOrderInCategory>40</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<prerequisite>Helios</prerequisite>
		<statFactors>
			<RawNutritionFactor>1.1</RawNutritionFactor>
			<ProcessedNutritionFactor>1.1</ProcessedNutritionFactor>
		</statFactors>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<!---->
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_Echolocation</defName>
		<label>Echolocation</label>
		<description>The carrier of the gene gains the ability to echolocation, borrowed from the animal world, which increases the effectiveness of his hearing.</description>
		<iconPath>Core/Genes/Helios_Echolocation</iconPath>
		<displayOrderInCategory>110</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>Helios_Halitius</prerequisite>
		<capMods>
			<li>
				<capacity>Hearing</capacity>
				<offset>0.25</offset>
			</li>
		</capMods>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_KeenVision</defName>
		<label>Keen vision</label>
		<description>The carrier of the gene further enhances their vision and gains the ability to distinguish additional shades of colors.</description>
		<iconPath>Core/Genes/Helios_KeenVision</iconPath>
		<displayOrderInCategory>120</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>Helios</prerequisite>
		<capMods>
			<li>
				<capacity>Sight</capacity>
				<offset>0.25</offset>
			</li>
		</capMods>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_StrengthenedMuscles</defName>
		<label>Strengthened muscles</label>
		<description>The muscle structure becomes stronger, which allows you to move faster and makes the body more stable.</description>
		<iconPath>Core/Genes/Helios_StrengthenedMuscles</iconPath>
		<displayOrderInCategory>130</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-2</biostatMet>
		<prerequisite>Helios</prerequisite>
		<capMods>
			<li>
				<capacity>Moving</capacity>
				<offset>0.15</offset>
			</li>
		</capMods>
		<statFactors>
			<MuscleBuilding>1.15</MuscleBuilding>
		</statFactors>
		<statOffsets>
			<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.1</ArmorRating_Sharp>
		</statOffsets>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_FortifiedBones</defName>
		<label>Fortified bones</label>
		<description>Skeletal bones supplement their composition with durable metals from food, which can significantly strengthen them.</description>
		<iconPath>Core/Genes/Helios_FortifiedBones</iconPath>
		<displayOrderInCategory>140</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-2</biostatMet>
		<prerequisite>Helios</prerequisite>
		<statOffsets>
			<ArmorRating_Blunt>1</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.25</ArmorRating_Sharp>
		</statOffsets>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<!---->
	<!---->
	<GeneDef ParentName="GeneHeliosBase">
		<defName>Helios_BioferriteIntegration</defName>
		<label>Bioferrite integration</label>
		<description>The host receives an additional organ placed above the liver, which accumulates bioferrite, used to quickly repair the body. Regenerated body parts are less effective than their natural counterparts, but they are better than nothing.</description>
		<geneClass>ProjectParagon.Core.Things.Genes.Gene_BioferriteIntegration</geneClass>
		<iconPath>Core/Genes/Helios_BioferriteIntegration</iconPath>
		<displayOrderInCategory>300</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-2</biostatMet>
		<prerequisite>Helios</prerequisite>
		<damageFactors>
			<EMP>3</EMP>
			<Electrical>3</Electrical>
		</damageFactors>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<overrideGeneBackground>Core/Genes/GeneBackground_GeneticEngineering</overrideGeneBackground>
				<showInEditor>false</showInEditor>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<!---->
	<!---->
</Defs>