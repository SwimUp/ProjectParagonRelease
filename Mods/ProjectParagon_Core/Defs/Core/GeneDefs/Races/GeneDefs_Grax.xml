<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<GeneDef Name="GeneGraxBase" Abstract="True">
		<displayCategory>Grax</displayCategory>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneGraxBase">
		<defName>Grax</defName>
		<label>Grax</label>
		<description>Silicon life form with a special metabolism.</description>
		<iconPath>Core/Genes/Grax</iconPath>
		<displayOrderInCategory>0</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>0</biostatMet>
		<exclusionTags>
			<li>Race</li>
		</exclusionTags>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>GraxRace</li>
				</relatedRaces>
				<genepackGenerated>false</genepackGenerated>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneGraxBase">
		<defName>SulfurNeed</defName>
		<label>Sulfur need</label>
		<description>The creature requires the consumption of sulfur for digestion.</description>
		<iconPath>Core/Genes/SulfurNeed</iconPath>
		<displayOrderInCategory>10</displayOrderInCategory>
		<prerequisite>Grax</prerequisite>
		<biostatCpx>1</biostatCpx>
		<biostatMet>5</biostatMet>
		<causesNeed>Need_Sulfur</causesNeed>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>GraxRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneGraxBase">
		<defName>ThermalMetabolism</defName>
		<label>Thermal metabolism</label>
		<description>Being in a hot place can partially reduce the wearer's need for sunlight.</description>
		<geneClass>ProjectParagon.Core.Things.Genes.Gene_ForceHediff</geneClass>
		<iconPath>Core/Genes/ThermalMetabolism</iconPath>
		<displayOrderInCategory>20</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>SunRequirement</prerequisite>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>GraxRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
				<props Class="ProjectParagon.Core.Things.Genes.GeneProperties_ForceHediff">
					<hediffDef>ThermalMetabolism</hediffDef>
					<canAffectAnyLivePart>false</canAffectAnyLivePart>
					<severity>0.41</severity>
					<count>1</count>
					<interval>60000</interval>
				</props>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneGraxBase" Name="CrystallineGrowths" Abstract="true">
