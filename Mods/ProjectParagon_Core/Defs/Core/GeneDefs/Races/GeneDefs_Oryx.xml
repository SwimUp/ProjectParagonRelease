	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneOryxBase">
		<defName>BirdTail</defName>
		<label>Bird's tail</label>
		<description>The carrier of the gene has a large bird's tail, which looks beautiful and helps regulate flight.</description>
		<iconPath>Core/Genes/BirdTail</iconPath>
		<displayOrderInCategory>60</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>Oryx</prerequisite>
		<exclusionTags>
			<li>Tail</li>
		</exclusionTags>
		<renderNodeProperties>
			<li>
				<workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
				<texPaths>
					<li>Things/Pawn/Humanlike/Wings/BirdTailA</li>
					<li>Things/Pawn/Humanlike/Wings/BirdTailB</li>
					<li>Things/Pawn/Humanlike/Wings/BirdTailC</li>
				</texPaths>
				<!--<texPath>Things/Pawn/Humanlike/Wings/BirdTail</texPath>-->
				<drawSize>1</drawSize>
				<parentTagDef>Body</parentTagDef>
				<color>(255, 255, 255)</color>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<colorType>Hair</colorType>
				<drawData>
					<defaultData>
						<layer>48</layer>
					</defaultData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<dataNorth>
						<offset>(0, 0, -0.7)</offset>
						<layer>51</layer>
					</dataNorth>
					<dataWest>
						<offset>(0.2, 0, 0)</offset>
						<layer>48</layer>
					</dataWest>
					<dataEast>
						<offset>(-0.2, 0, 0)</offset>
						<layer>48</layer>
					</dataEast>
				</drawData>
			</li>
		</renderNodeProperties>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>OryxRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneOryxBase">
		<defName>BirdBeak</defName>
		<label>Bird's beak</label>
		<description>Carriers of the gene have a beak, which makes food consumption quite inefficient.</description>
		<iconPath>Core/Genes/BirdBeak</iconPath>
		<displayOrderInCategory>70</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<prerequisite>Oryx</prerequisite>
		<statFactors>
			<EatingSpeed>0.75</EatingSpeed>
		</statFactors>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>OryxRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneOryxBase">
		<defName>ReproductionByEggs</defName>
		<label>Reproduction by eggs</label>
		<description>Carriers of the gene spread their species by laying eggs and maintaining them intact.</description>
		<geneClass>ProjectParagon.Core.Genes.Gene_ReproductionByEggs</geneClass>
		<iconPath>Core/Genes/ReproductionByEggs</iconPath>
		<displayOrderInCategory>80</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<prerequisite>Oryx</prerequisite>
		<modExtensions>
			<li Class="ProjectParagon.Core.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>OryxRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
</Defs>