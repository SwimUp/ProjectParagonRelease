<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<GeneDef Name="GeneTaurusBase" Abstract="True">
		<displayCategory>Taurus</displayCategory>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneTaurusBase">
		<defName>Taurus</defName>
		<label>Taurus</label>
		<labelShortAdj>Taurus</labelShortAdj>
		<description>The pawn is a humanoid mammal.</description>
		<iconPath>Core/Genes/Taurus</iconPath>
		<displayOrderInCategory>0</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>2</biostatMet>
		<exclusionTags>
			<li>Race</li>
		</exclusionTags>
		<forcedHeadTypes>
			<li>BovineMaleAverageHeadNormal</li>
			<li>BovineMaleAverageHeadWide</li>
			<li>BovineMaleAverageHeadPointy</li>
			<li>BovineFemaleAverageHeadNormal</li>
			<li>BovineFemaleAverageHeadWide</li>
			<li>BovineFemaleAverageHeadPointy</li>
			<li>Furskin_BovineMaleAverageHeadNormal</li>
			<li>Furskin_BovineMaleAverageHeadWide</li>
			<li>Furskin_BovineMaleAverageHeadPointy</li>
			<li>Furskin_BovineFemaleAverageHeadNormal</li>
			<li>Furskin_BovineFemaleAverageHeadWide</li>
			<li>Furskin_BovineFemaleAverageHeadPointy</li>
		</forcedHeadTypes>
		<renderNodeProperties>
			<li>
				<workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
				<texPath>Things/Pawn/Humanlike/BodyAttachments/Tails/BovineTail</texPath>
				<colorType>Skin</colorType>
				<overrideMeshSize>(1, 1)</overrideMeshSize>
				<parentTagDef>Body</parentTagDef>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<drawData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<defaultData>
						<layer>-3</layer>
					</defaultData>
					<dataNorth>
						<offset>(0.1, 0, -0.35)</offset>
						<layer>90</layer>
					</dataNorth>
					<dataSouth>
						<offset>(-0.1, 0, -0.25)</offset>
					</dataSouth>
					<dataEast>
						<offset>(-0.5, 0, -0.15)</offset>
					</dataEast>
					<dataWest>
						<offset>(0.5, 0, -0.15)</offset>
					</dataWest>
				</drawData>
			</li>
			<li>
				<workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
				<texPath>Things/Pawn/Humanlike/BodyAttachments/Tails/BovineTailTuft</texPath>
				<colorType>Hair</colorType>
				<overrideMeshSize>(1, 1)</overrideMeshSize>
				<parentTagDef>Body</parentTagDef>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<drawData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<defaultData>
						<layer>-2</layer>
					</defaultData>
					<dataNorth>
						<offset>(0.1, -0, -0.35)</offset>
						<layer>180</layer>
					</dataNorth>
					<dataSouth>
						<offset>(-0.1, 0, -0.25)</offset>
					</dataSouth>
					<dataEast>
						<offset>(-0.5, 0, -0.15)</offset>
					</dataEast>
					<dataWest>
						<offset>(0.5, 0, -0.15)</offset>
					</dataWest>
				</drawData>
			</li>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPath>Things/Pawn/Humanlike/HeadAttachments/BovineEars/BovineEars</texPath>
				<colorType>Skin</colorType>
				<parentTagDef>Head</parentTagDef>
				<useSkinShader>true</useSkinShader>
				<useRottenColor>true</useRottenColor>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<drawData>
					<defaultData>
						<layer>80</layer>
					</defaultData>
				</drawData>
			</li>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPaths>
					<li>Things/Pawn/Humanlike/HeadAttachments/Horns/Horns1</li>
					<li>Things/Pawn/Humanlike/HeadAttachments/Horns/Horns2</li>
					<li>Things/Pawn/Humanlike/HeadAttachments/Horns/Horns3</li>
					<li>Things/Pawn/Humanlike/HeadAttachments/Horns/Horns4</li>
					<li>Things/Pawn/Humanlike/HeadAttachments/Horns/Horns5</li>
					<li>Things/Pawn/Humanlike/HeadAttachments/Horns/Horns6</li>
				</texPaths>
				<color>(255, 255, 255)</color>
				<parentTagDef>Head</parentTagDef>
				<drawData>
					<defaultData>
						<layer>70</layer>
					</defaultData>
					<dataNorth>
						<layer>5</layer>
					</dataNorth>
				</drawData>
			</li>
		</renderNodeProperties>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>TaurusRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
				<genepackGenerated>false</genepackGenerated>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneTaurusBase">
		<defName>ThickSkin</defName>
		<label>Thick skin</label>
		<labelShortAdj>Thick skin</labelShortAdj>
		<description>Carriers of the gene have thick skin, which further enhances survival in harsh environments.</description>
		<iconPath>Core/Genes/ThickSkin</iconPath>
		<displayOrderInCategory>10</displayOrderInCategory>
		<biostatCpx>2</biostatCpx>
		<biostatMet>-1</biostatMet>
		<statOffsets>
			<ComfyTemperatureMin>-25</ComfyTemperatureMin>
			<ComfyTemperatureMax>10</ComfyTemperatureMax>
			<ArmorRating_Sharp>1</ArmorRating_Sharp>
		</statOffsets>
		<exclusionTags>
			<li>NaturalSkin</li>
		</exclusionTags>
		<prerequisite>Taurus</prerequisite>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>TaurusRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneTaurusBase">
		<defName>StrongMuscles</defName>
		<label>Strong muscles</label>
		<labelShortAdj>Strong muscles</labelShortAdj>
		<description>The carrier of the gene has a stronger muscle structure, which increases the overall level of its strength.</description>
		<iconPath>Core/Genes/StrongMuscles</iconPath>
		<displayOrderInCategory>20</displayOrderInCategory>
		<biostatCpx>2</biostatCpx>
		<biostatMet>-1</biostatMet>
		<statOffsets>
			<CarryWeight>15</CarryWeight>
			<CarryingCapacity>20</CarryingCapacity>
			<MuscleBuilding>1.3</MuscleBuilding>
		</statOffsets>
		<prerequisite>Taurus</prerequisite>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>TaurusRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneTaurusBase">
		<defName>AcceleratedMetabolism</defName>
		<label>Accelerated metabolism</label>
		<labelShortAdj>Accelerated metabolism</labelShortAdj>
		<geneClass>ProjectParagon.Core.Things.Genes.Gene_AcceleratedMetabolism</geneClass>
		<description>The gene bestows an accelerated metabolism, due to which the carrier consumes more food, but gets tired more slowly.</description>
		<iconPath>Core/Genes/AcceleratedMetabolism</iconPath>
		<displayOrderInCategory>30</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-2</biostatMet>
		<prerequisite>Taurus</prerequisite>
		<modExtensions>
			<li Class="ProjectParagon.Core.Things.Genes.DefExtension_Gene">
				<relatedRaces>
					<li>TaurusRace</li>
				</relatedRaces>
				<overrideGeneBackground>Core/Genes/GeneBackground_Xenos</overrideGeneBackground>
			</li>
		</modExtensions>
	</GeneDef>
	<!---->
</Defs>