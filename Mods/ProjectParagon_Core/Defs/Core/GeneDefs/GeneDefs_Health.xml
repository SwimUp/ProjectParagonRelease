<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<GeneDef>
		<defName>ScarTreatment</defName>
		<label>Scar treatment</label>
		<description>The carrier of the gene regenerates severe tissue damage that caused scars.</description>
		<iconPath>Core/Genes/ScarTreatment</iconPath>
		<displayOrderInCategory>500</displayOrderInCategory>
		<biostatMet>-2</biostatMet>
		<biostatCpx>1</biostatCpx>
		<geneClass>ProjectParagon.Core.Genes.Gene_ScarTreatment</geneClass>
		<displayCategory>Healing</displayCategory>
	</GeneDef>
	<!---->
	<GeneDef>
		<defName>WeakMusculature</defName>
		<label>Weak musculature</label>
		<description>It is difficult for a carrier of the gene to build good muscles.</description>
		<iconPath>Core/Genes/BodyRed</iconPath>
		<displayOrderInCategory>600</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<statFactors>
			<MuscleBuilding>0.5</MuscleBuilding>
		</statFactors>
		<exclusionTags>
			<li>Musculature</li>
		</exclusionTags>
		<displayCategory>Healing</displayCategory>
	</GeneDef>
	<!---->
	<GeneDef>
		<defName>StrongMusculature</defName>
		<label>Strong musculature</label>
		<description>It is much easier for a carrier of the gene to build good muscles.</description>
		<iconPath>Core/Genes/BodyGreen</iconPath>
		<displayOrderInCategory>610</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-2</biostatMet>
		<statFactors>
			<MuscleBuilding>2</MuscleBuilding>
		</statFactors>
		<exclusionTags>
			<li>Musculature</li>
		</exclusionTags>
		<displayCategory>Healing</displayCategory>
	</GeneDef>
	<!---->
	<GeneDef>
		<defName>Regrowing</defName>
		<label>Regrowing</label>
		<labelShortAdj>Regrowing</labelShortAdj>
		<description>Carriers of this gene are able to regenerate lost limbs and organs over time.</description>
		<geneClass>ProjectParagon.Core.Genes.Gene_Regrowing</geneClass>
		<iconPath>Core/Genes/Regrowing</iconPath>
		<displayOrderInCategory>490</displayOrderInCategory>
		<biostatCpx>2</biostatCpx>
		<biostatMet>-2</biostatMet>
		<displayCategory>Healing</displayCategory>
	</GeneDef>
	<!---->
</Defs>