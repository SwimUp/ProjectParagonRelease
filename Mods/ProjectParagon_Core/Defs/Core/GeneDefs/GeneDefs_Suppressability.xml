<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<GeneDef Name="GeneSuppressabilityBase" Abstract="True">
		<displayCategory>Suppressability</displayCategory>
		<exclusionTags>
			<li>Suppressability</li>
		</exclusionTags>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneSuppressabilityBase">
		<defName>Suppressability_VeryFearfull</defName>
		<label>Very fearfull</label>
		<description>The carrier of the gene will tend to run away from the battlefield at the sight of danger.</description>
		<iconPath>Core/Genes/VeryFearfull</iconPath>
		<displayOrderInCategory>10</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>2</biostatMet>
		<statFactors>
			<Suppressability>3</Suppressability>
		</statFactors>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneSuppressabilityBase">
		<defName>Suppressability_Fearfull</defName>
		<label>Fearfull</label>
		<description>It is difficult for the carrier of the gene to resist danger; he strives to escape from it.</description>
		<iconPath>Core/Genes/Fearfull</iconPath>
		<displayOrderInCategory>20</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<statFactors>
			<Suppressability>1.5</Suppressability>
		</statFactors>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneSuppressabilityBase">
		<defName>Suppressability_ReducedFear</defName>
		<label>Reduced fear</label>
		<description>The carrier of the gene shows himself to be resistant to danger and meets it face to face.</description>
		<iconPath>Core/Genes/ReducedFear</iconPath>
		<displayOrderInCategory>30</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<statFactors>
			<Suppressability>0.5</Suppressability>
		</statFactors>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneSuppressabilityBase">
		<defName>Suppressability_Fearlessness</defName>
		<label>Fearlessness</label>
		<description>The carrier of the gene seems to be incapable of feeling fear. He will not suffer from suppression in battle.</description>
		<iconPath>Core/Genes/Fearlessness</iconPath>
		<displayOrderInCategory>40</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-2</biostatMet>
		<statFactors>
			<Suppressability>0</Suppressability>
		</statFactors>
	</GeneDef>
	<!---->
</Defs>
