<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<GeneDef Name="GeneMaxNutritionBase" Abstract="True">
		<displayCategory>Needs</displayCategory>
		<exclusionTags>
			<li>MaxNutrition</li>
		</exclusionTags>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneMaxNutritionBase">
		<defName>MaxNutrition_BigStomach</defName>
		<label>Big stomach</label>
		<labelShortAdj>Big stomach</labelShortAdj>
		<description>The carrier of the gene has a very wide stomach, which allows him to stay full longer and accommodate more food.</description>
		<iconPath>Core/Genes/BigStomach</iconPath>
		<displayOrderInCategory>500</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-2</biostatMet>
		<statFactors>
			<MaxNutrition>2</MaxNutrition>
		</statFactors>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneMaxNutritionBase">
		<defName>MaxNutrition_EnlargedStomach</defName>
		<label>Enlarged stomach</label>
		<labelShortAdj>Enlarged stomach</labelShortAdj>
		<description>The carrier of the gene has an enlarged stomach, which allows it to hold more food.</description>
		<iconPath>Core/Genes/EnlargedStomach</iconPath>
		<displayOrderInCategory>510</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<statFactors>
			<MaxNutrition>1.5</MaxNutrition>
		</statFactors>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneMaxNutritionBase">
		<defName>MaxNutrition_ReducedStomach</defName>
		<label>Reduced stomach</label>
		<labelShortAdj>Reduced stomach</labelShortAdj>
