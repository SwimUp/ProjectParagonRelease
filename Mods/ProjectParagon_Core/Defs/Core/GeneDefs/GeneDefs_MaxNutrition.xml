		<displayOrderInCategory>520</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<statFactors>
			<MaxNutrition>0.75</MaxNutrition>
		</statFactors>
	</GeneDef>
	<!---->
	<GeneDef ParentName="GeneMaxNutritionBase">
		<defName>MaxNutrition_SmallStomach</defName>
		<label>Small stomach</label>
		<labelShortAdj>Small stomach</labelShortAdj>
		<description>The carrier of the gene has a very narrow stomach, which forces him to eat much more often to survive.</description>
		<iconPath>Core/Genes/SmallStomach</iconPath>
		<displayOrderInCategory>530</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
