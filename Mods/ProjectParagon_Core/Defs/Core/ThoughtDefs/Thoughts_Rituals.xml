<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!---->
	<ThoughtDef>
		<defName>TerribleBanquet</defName>
		<thoughtClass>Thought_AttendedRitual</thoughtClass>
		<durationDays>7</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>terrible banquet</label>
				<description>That banquet was horrible. I'm still cringing from the awkwardness flashbacks.</description>
				<baseMoodEffect>-4</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>BoringBanquet</defName>
		<thoughtClass>Thought_AttendedRitual</thoughtClass>
		<durationDays>7</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>boring banquet</label>
				<description>That banquet was awkward. I wish I could have left.</description>
				<baseMoodEffect>-2</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>FunBanquet</defName>
		<thoughtClass>Thought_AttendedRitual</thoughtClass>
		<durationDays>7</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>fun banquet</label>
				<description>I had fun! We got to hang out and relax.</description>
				<baseMoodEffect>7</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>UnforgettableBanquet</defName>
		<thoughtClass>Thought_AttendedRitual</thoughtClass>
		<durationDays>7</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>unforgettable banquet</label>
				<description>That banquet was something I'll never forget.</description>
				<baseMoodEffect>10</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<!---->
</Defs>
