<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<AlienRace.ThingDef_AlienRace ParentName="ParagonBasePawn">
		<defName>OryxRace</defName>
		<label>Oryx</label>
		<description>Oryx are rather fragile xenos creatures that prefer to live in wooded areas. They are light enough to fly using short hops. Representatives of the species have feather cover and hollow bones, and their hind limbs are not inferior to the forelimbs in their flexibility. Oryx are capable of using tools with their legs.</description>
		<statBases>
			<PsychicSensitivity>1</PsychicSensitivity>
			<ToxicResistance>0</ToxicResistance>
			<Mass>40</Mass>
			<ComfyTemperatureMin>-10</ComfyTemperatureMin>
			<ComfyTemperatureMax>28</ComfyTemperatureMax>
			<LeatherAmount>50</LeatherAmount>
			<RoyalFavorValue>0</RoyalFavorValue>
			<ArmorRating_Blunt>0</ArmorRating_Blunt>
			<ArmorRating_Sharp>0</ArmorRating_Sharp>
			<ArmorRating_Heat>0</ArmorRating_Heat>
			<MeleeDodgeChance>3</MeleeDodgeChance>
			<MeleeCritChance>1.5</MeleeCritChance>
			<MeleeParryChance>3</MeleeParryChance>
			<MarketValue>1500</MarketValue>
			<MoveSpeed>5</MoveSpeed>
			<Flammability>2</Flammability>
			<ResearchSpeed>1</ResearchSpeed>
			<ImmunityGainSpeed>1</ImmunityGainSpeed>
		</statBases>
		<comps>
			<li Class="ProjectParagon.Core.Things.CompProperties_Seedable">
				<seedlingPawnKindDef>Newborn_Oryx</seedlingPawnKindDef>
				<growthSpeedMultiplier>0.85</growthSpeedMultiplier>
			</li>
			<li>
				<compClass>CombatExtended.CompPawnGizmo</compClass>
			</li>
			<li Class="CombatExtended.CompProperties_Suppressable"/>
			<li Class="ProjectParagon.Core.Things.Pawns.CompProperties_PawnParagon"/>
		</comps>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<capacities>
					<li>Scratch</li>
				</capacities>
				<power>2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
				<chanceFactor>0.4</chanceFactor>
				<armorPenetrationBlunt>2</armorPenetrationBlunt>
			</li>
			<li Class="CombatExtended.ToolCE">
				<capacities>
					<li>Scratch</li>
				</capacities>
				<power>2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
				<chanceFactor>0.4</chanceFactor>
				<armorPenetrationBlunt>2</armorPenetrationBlunt>
			</li>
			<li Class="CombatExtended.ToolCE">
				<capacities>
					<li>Scratch</li>
				</capacities>
				<power>3</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Legs</linkedBodyPartsGroup>
				<chanceFactor>0.2</chanceFactor>
				<armorPenetrationBlunt>3</armorPenetrationBlunt>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>teeth</label>
				<capacities>
					<li>Scratch</li>
				</capacities>
				<power>5</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.07</chanceFactor>
				<soundMeleeHit>Pawn_Melee_HumanBite_Hit</soundMeleeHit>
				<soundMeleeMiss>Pawn_Melee_HumanBite_Miss</soundMeleeMiss>
				<armorPenetrationBlunt>4</armorPenetrationBlunt>
			</li>
		</tools>
		<alienRace>
			<generalSettings>
				<humanRecipeImport>true</humanRecipeImport>
				<alienPartGenerator>
					<bodyTypes>
						<li>Thin</li>
					</bodyTypes>
					<headTypes>
						<li>Male_AverageNormal</li>
						<li>Male_AveragePointy</li>
						<li>Male_AverageWide</li>
						<li>Male_NarrowNormal</li>
						<li>Female_AverageNormal</li>
						<li>Female_AveragePointy</li>
						<li>Female_AverageWide</li>
						<li>Female_NarrowNormal</li>
					</headTypes>
				</alienPartGenerator>
				<immuneToAge>false</immuneToAge>
				<maxDamageForSocialfight>8</maxDamageForSocialfight>
				<allowHumanBios>false</allowHumanBios>
				<maleGenderProbability>0.5</maleGenderProbability>
				<chemicalSettings>
				</chemicalSettings>
				<disallowedTraits>		
				</disallowedTraits>
			</generalSettings>
			<graphicPaths>
				<head>
					<path>Core/Races/Oryx/Head/</path>
				</head>
				<body>
					<path>Core/Races/Oryx/Body/</path>
				</body>
			</graphicPaths>
			<styleSettings>
				<li>
					<key>HairDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
				<li>
					<key>BeardDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
				<li>
					<key>TattooDef</key>
					<value>
						<hasStyle>false</hasStyle>
					</value>
				</li>
			</styleSettings>
			<relationSettings>
				<relationChanceModifierChild>1</relationChanceModifierChild>
				<relationChanceModifierExLover>1</relationChanceModifierExLover>
				<relationChanceModifierExSpouse>1</relationChanceModifierExSpouse>
				<relationChanceModifierFiance>1</relationChanceModifierFiance>
				<relationChanceModifierLover>1</relationChanceModifierLover>
				<relationChanceModifierParent>1</relationChanceModifierParent>
				<relationChanceModifierSibling>1</relationChanceModifierSibling>
				<relationChanceModifierSpouse>1</relationChanceModifierSpouse>
			</relationSettings>
			<thoughtSettings>
				<cannotReceiveThoughts>
				</cannotReceiveThoughts>
				<ateThoughtSpecific>
				</ateThoughtSpecific>
				<replacerList>
				</replacerList>
			</thoughtSettings>
			<raceRestriction>
				<whiteReproductionList>
					<li>OryxRace</li>
				</whiteReproductionList>
				<onlyReproduceWithRestrictedRaces>true</onlyReproduceWithRestrictedRaces>
			</raceRestriction>
		</alienRace>
		<modExtensions>
			<li Class="CombatExtended.RacePropertiesExtensionCE">
				<bodyShape>Humanoid</bodyShape>
			</li>
			<li Class="ProjectParagon.Core.Things.RacePropertiesDefModExtension">
				<overrideMeatDef>Meat_Human</overrideMeatDef>
				<xenosHediffFilter>
				</xenosHediffFilter>
				<defaultRaceLanguage>Flavian</defaultRaceLanguage>
			</li>
		</modExtensions>
		<race>
			<thinkTreeMain>Humanlike</thinkTreeMain>
			<nameGenerator>NamerPersonOryxMale</nameGenerator>
			<nameGeneratorFemale>NamerPersonOryxFemale</nameGeneratorFemale>
			<thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
			<intelligence>Humanlike</intelligence>
			<bloodDef>Filth_Blood</bloodDef>
			<makesFootprints>true</makesFootprints>
			<lifeExpectancy>30</lifeExpectancy>
			<leatherDef>Light_Leather</leatherDef>
			<nameCategory>HumanStandard</nameCategory>
			<body>OryxBody</body>
			<baseBodySize>0.7</baseBodySize>
			<baseHealthScale>0.5</baseHealthScale>
			<baseHungerRate>1</baseHungerRate>
			<foodType>OmnivoreHuman</foodType>
			<hasGenders>true</hasGenders>
			<gestationPeriodDays>40</gestationPeriodDays>
			<litterSizeCurve>
				<points>
					<li>(0.5, 0)</li>
					<li>(1, 1)</li>
					<li>(1.01, 0.02)</li>
					<li>(3.5, 0)</li>
				</points>
			</litterSizeCurve>
			<lifeStageAges>
				<li>
					<def>HumanlikeBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>HumanlikeChild</def>
					<minAge>1</minAge>
				</li>
				<li>
					<def>HumanlikeTeenager</def>
					<minAge>4</minAge>
				</li>
				<li>
					<def>HumanlikeAdult</def>
					<minAge>6</minAge>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
			<ageGenerationCurve>
				<points>
					<li>(8,0)</li>
					<li>(10,100)</li>
					<li>(30,10)</li>
					<li>(40,0)</li>
				</points>
			</ageGenerationCurve>
			<hediffGiverSets>
				<li>OrganicHumanlikeGroup</li>
				<li>OrganicOryxGroup</li>
				<li>Human</li>
			</hediffGiverSets>
		</race>
		<recipes>
			<li>ExciseCarcinoma</li>
			<li>AdministerMechSerumHealer</li>
			<li>RemoveBodyPart</li>
			<li>Euthanize</li>
			<li>Anesthetize</li>
			<li>CureScaria</li>
			<li MayRequire="Ludeon.RimWorld.Royalty">CureBloodRot</li>
			<li MayRequire="Ludeon.RimWorld.Royalty">CureAbasia</li>
		</recipes>
		<ingredient>
			<mergeCompatibilityTags>
				<li>HumanMeat</li>
			</mergeCompatibilityTags>
		</ingredient>
	</AlienRace.ThingDef_AlienRace>
	<RulePackDef>
		<defName>NamerPersonOryxMale</defName>
		<rulePack>
			<rulesStrings>
				<li>name->[FirstName] [LastName]</li>
			</rulesStrings>
			<rulesRaw>
				<li Class="Rule_File">
					<keyword>FirstName</keyword>
