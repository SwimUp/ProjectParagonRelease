<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef ParentName="ImplantHediffBase" Name="SkillChipHediffBase" Abstract="true">
		<description>A skill chip that enhances the owner's abilities through the power of technology.</description>
	</HediffDef>
	<ThingDef ParentName="ProsthesisSpacerBase" Name="SkillChipThingBase" Abstract="true">
		<description>A skill chip that enhances the owner's abilities through the power of technology.</description>
		<graphicData>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<Mass>1</Mass>
			<MarketValue>500</MarketValue>
		</statBases>
		<recipeMaker>
			<workSpeedStat>SmeltingSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smelt</effectWorking>
			<soundWorking>Recipe_Machining</soundWorking>
			<researchPrerequisite>SkillChips</researchPrerequisite>
			<recipeUsers>
				<li>Bioprinter</li>
			</recipeUsers>
			<unfinishedThingDef>ProstheticParagon_T4_</unfinishedThingDef>
			<skillRequirements>
				<Crafting>10</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<MechanitesCapsule>1</MechanitesCapsule>
			<Synthread>25</Synthread>
			<Biosynthetics>50</Biosynthetics>
		</costList>
		<comps Inherit="false">
			<li Class="CompProperties_Forbiddable"/>
		</comps>
	</ThingDef>
	<RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase" Name="SkillChipRecipeBase" Abstract="true">
		<description>Install a skill chip.</description>
		<jobString>Installing skill chip.</jobString>
		<appliedOnFixedBodyParts>
			<li>Brain</li>
		</appliedOnFixedBodyParts>
		<researchPrerequisite>SkillChips</researchPrerequisite>
	</RecipeDef>
	<!---->
	<HediffDef ParentName="SkillChipHediffBase">
		<defName>SkillChip_Melee</defName>
		<label>Skill chip (Melee)</label>
		<labelNoun>a death acidifier</labelNoun>
		<spawnThingOnRemoved>DeathAcidifier</spawnThingOnRemoved>
		<aptitudes>
			<Melee>4</Melee>
		</aptitudes>
