<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef ParentName="AddedBodyPartBase">
		<defName>BionicLiver</defName>
		<label>Bionic liver</label>
		<labelNoun>a bionic liver</labelNoun>
		<description>A simple liver prosthesis made from bionic components and gears.</description>
		<spawnThingOnRemoved>BionicLiver</spawnThingOnRemoved>
		<addedPartProps>
			<solid>true</solid>
			<partEfficiency>1.25</partEfficiency>
		</addedPartProps>
		<priceImpact>true</priceImpact>
		<countsAsAddedPartOrImplant>true</countsAsAddedPartOrImplant>
		<comps>
			<li Class="ProjectParagon.Core.Hediffs.HediffCompProperties_PartHitPoints">
				<multiplier>1.25</multiplier>
			</li>
		</comps>
		<modExtensions>
			<li Class="ParagonWiki.Other.DefExtension_Wiki">
				<wikiExtraInfo Class="ProjectParagon.Wiki.WikiExtraInfo_WikiHediffDef"/>
			</li>
		</modExtensions>
	</HediffDef>
	<ThingDef ParentName="ProsthesisSpacerBase">
		<defName>BionicLiver</defName>
		<label>Bionic liver</label>
		<description>A prosthesis made from bionic components and gears.</description>
		<graphicData>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<Mass>4.0</Mass>
		</statBases>
		<recipeMaker>
			<workSpeedStat>SmeltingSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smelt</effectWorking>
			<soundWorking>Recipe_Machining</soundWorking>
			<researchPrerequisite>Bionics</researchPrerequisite>
			<recipeUsers>
				<li>Bioprinter</li>
			</recipeUsers>
			<unfinishedThingDef>ProstheticParagon_T4_</unfinishedThingDef>
		</recipeMaker>
		<stuffCategories>
			<li>Metallic</li>
			<li>Plastic</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<costList>
			<MechanitesCapsule>1</MechanitesCapsule>
			<Synthread>75</Synthread>
			<Biosynthetics>150</Biosynthetics>
		</costList>
	</ThingDef>
	<RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
		<defName>BionicLiver</defName>
		<label>install bionic liver</label>
		<description>Install a bionic liver.</description>
		<jobString>Installing bionic liver.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>BionicLiver</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>BionicLiver</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>Liver</li>
		</appliedOnFixedBodyParts>
		<addsHediff>BionicLiver</addsHediff>
		<researchPrerequisite>Bionics</researchPrerequisite>
	</RecipeDef>
</Defs>