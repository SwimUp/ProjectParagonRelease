			<li>
				<label>has 3 fight style</label>
				<description>I'm stronger than you!</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<!---->
	<PreceptDef>
		<defName>Battlecraft_Neutral</defName>
		<issue>Battlecraft</issue>
		<label>Neutral</label>
		<description>Martial arts are exciting, but you shouldn't attach such importance to it.</description>
		<impact>Low</impact>
		<displayOrderInIssue>10</displayOrderInIssue>
