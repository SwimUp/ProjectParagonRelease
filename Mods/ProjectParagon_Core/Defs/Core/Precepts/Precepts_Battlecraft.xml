<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<IssueDef>
		<defName>Battlecraft</defName>
		<label>Battlecraft</label>
		<iconPath>Core/UI/Issues/Battlecraft</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>Battlecraft_Exalted</defName>
		<issue>Battlecraft</issue>
		<label>Exalted</label>
		<description>Mastery of martial arts is the norm of life. We must always be ready to fight.</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>Supremacist</li>
			<li>Raider</li>
		</associatedMemes>
		<conflictingMemes>
			<li>HighLife</li>
		</conflictingMemes>
		<comps>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>NewFightStyleLearned</eventDef>
				<thought>NewFightStyleLearned_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>NewFightStyleLearned</eventDef>
				<thought>NewFightStyleLearned_Know_Exalted</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>HasFightStyle_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_GainCulture">
				<eventDef>NewFightStyleLearned</eventDef>
				<curvePointsByTechLevel>
					<points>
						<!-- None -->
						<li>0, 10</li>
						<!-- Племя -->
						<li>1, 10</li>
						<!-- Средневековье -->
						<li>2, 15</li>
						<!-- Индастриал -->
						<li>3, 20</li>
						<!-- Космос -->
						<li>4, 25</li>
						<!-- Ультра -->
						<li>5, 30</li>
					</points>
				</curvePointsByTechLevel>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>NewFightStyleLearned_Exalted</defName>
		<durationDays>7</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>fight style learned</label>
				<description>I'm approaching perfect mastery!</description>
				<baseMoodEffect>6</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>NewFightStyleLearned_Know_Exalted</defName>
		<thoughtClass>Thought_MemorySocial</thoughtClass>
		<durationDays>10</durationDays>
		<stackLimit>100</stackLimit>
		<stackLimitForSameOtherPawn>5</stackLimitForSameOtherPawn>
		<stages>
			<li>
				<label>fight style learned</label>
				<baseOpinionOffset>10</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>HasFightStyle_Exalted</defName>
		<workerClass>ProjectParagon.Core.Thoughts.ThoughtWorker_Precept_AlwaysActive_HasFightStyle</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>has mot fight style</label>
				<description>I'm nothing!</description>
				<baseMoodEffect>-6</baseMoodEffect>
			</li>
			<li>
				<label>has 1 fight style</label>
				<description>I'm nothing!</description>
				<baseMoodEffect>0</baseMoodEffect>
			</li>
			<li>
				<label>has 2 fight style</label>
				<description>I'm nothing!</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
			<li>
				<label>has 3 fight style</label>
				<description>I'm stronger than you!</description>
				<baseMoodEffect>5</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<!---->
