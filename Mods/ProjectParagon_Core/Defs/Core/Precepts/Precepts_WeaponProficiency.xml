<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<IssueDef>
		<defName>WeaponProficiency</defName>
		<label>Weapon proficiency</label>
		<iconPath>Core/UI/Issues/WeaponProficiency</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>WeaponProficiency_Exalted</defName>
		<issue>WeaponProficiency</issue>
		<label>Exalted</label>
		<description>Owning your own weapon is everyone’s sacred duty!</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>Supremacist</li>
			<li>Raider</li>
			<li>Nobility</li>
		</associatedMemes>
		<conflictingMemes>
			<li>HighLife</li>
		</conflictingMemes>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>WeaponProficiency_Exalted</thought>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>WeaponProficiency_Exalted</defName>
		<workerClass>ProjectParagon.Core.Thoughts.ThoughtWorker_Precept_AlwaysActive_WeaponProficiency</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>no weapon</label>
				<description>I'm weak!</description>
				<baseMoodEffect>-5</baseMoodEffect>
			</li>
			<li>
				<label>poor weapon skills</label>
				<description>I'm not good enough.</description>
				<baseMoodEffect>-5</baseMoodEffect>
			</li>
			<li>
				<label>normal weapon skills</label>
				<description>I have something to strive for.</description>
				<baseMoodEffect>0</baseMoodEffect>
			</li>
			<li>
				<label>good weapon skills</label>
				<description>I'm getting closer to mastery.</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
			<li>
				<label>legendary weapon skills</label>
				<description>I am a true master of combat!</description>
				<baseMoodEffect>6</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<!---->
	<PreceptDef>
		<defName>WeaponProficiency_Encouraged</defName>
		<issue>WeaponProficiency</issue>
		<label>Encouraged</label>
		<description>Every person must be proficient in his combat weapons.</description>
		<impact>Medium</impact>
		<displayOrderInIssue>20</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>Supremacist</li>
			<li>Raider</li>
			<li>Nobility</li>
		</associatedMemes>
		<conflictingMemes>
			<li>HighLife</li>
		</conflictingMemes>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>WeaponProficiency_Encouraged</thought>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>WeaponProficiency_Encouraged</defName>
		<workerClass>ProjectParagon.Core.Thoughts.ThoughtWorker_Precept_AlwaysActive_WeaponProficiency</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>no weapon</label>
				<description>I'm weak!</description>
				<baseMoodEffect>-2</baseMoodEffect>
			</li>
			<li>
				<label>poor weapon skills</label>
				<description>I'm not good enough.</description>
				<baseMoodEffect>-2</baseMoodEffect>
			</li>
			<li>
				<label>normal weapon skills</label>
				<description>I have something to strive for.</description>
				<baseMoodEffect>0</baseMoodEffect>
			</li>
			<li>
				<label>good weapon skills</label>
				<description>I'm getting closer to mastery.</description>
				<baseMoodEffect>1</baseMoodEffect>
			</li>
			<li>
				<label>legendary weapon skills</label>
				<description>I am a true master of combat!</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<!---->
	<PreceptDef>
		<defName>WeaponProficiency_Neutral</defName>
		<issue>WeaponProficiency</issue>
		<label>Neutral</label>
		<description>Owning a weapon has only military value. You shouldn't attach so much importance to this.</description>
		<impact>Low</impact>
		<displayOrderInIssue>10</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<defaultSelectionWeight>1</defaultSelectionWeight>
	</PreceptDef>
	<!---->
</Defs>
