		<iconPath>Core/UI/Issues/Recruiting</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>Recruiting_Exalted</defName>
		<issue>Recruiting</issue>
		<label>Exalted</label>
		<description>Recruiting new members of the colony is what we need to focus on.</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>Proselytizer</li>
		</associatedMemes>
		<comps>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>PawnRecruit</eventDef>
				<thought>PawnRecruit_Exalted</thought>
			</li>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>PawnRecruitByPawn</eventDef>
				<thought>PawnRecruit_Recruiter_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>PawnRecruitByPawn</eventDef>
				<thought>PawnRecruit_Recruiter_Know_Exalted</thought>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>PawnRecruit_Exalted</defName>
		<durationDays>7</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>pawn recruited</label>
				<description>We are always happy to join the ranks.</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>PawnRecruit_Recruiter_Exalted</defName>
		<durationDays>7</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>pawn recruited by me</label>
				<description>I'm so proud that I was able to make a difference.</description>
				<baseMoodEffect>5</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>PawnRecruit_Recruiter_Know_Exalted</defName>
		<thoughtClass>Thought_MemorySocial</thoughtClass>
		<durationDays>7</durationDays>
		<stackLimit>100</stackLimit>
		<stackLimitForSameOtherPawn>3</stackLimitForSameOtherPawn>
		<stages>
			<li>
				<label>pawn recruited</label>
				<baseOpinionOffset>10</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>
