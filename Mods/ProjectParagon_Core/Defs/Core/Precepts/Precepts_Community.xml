<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<IssueDef>
		<defName>Community</defName>
		<label>Community</label>
		<iconPath>Core/UI/Issues/Community</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>Community_Exalted</defName>
		<issue>Community</issue>
		<label>Exalted</label>
		<description>Our strength is in numbers! We are glad to see new people in our ranks.</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>Collectivist</li>
		</associatedMemes>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>Community_Exalted</thought>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>Community_Exalted</defName>
		<workerClass>ProjectParagon.Core.Thoughts.ThoughtWorker_Precept_AlwaysActive_Community</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>loneliness</label>
				<description>I was left all alone... It's so sad.</description>
				<baseMoodEffect>-10</baseMoodEffect>
			</li>
			<li>
				<label>small community</label>
				<description>Just a few people, we have room to grow.</description>
				<baseMoodEffect>-4</baseMoodEffect>
			</li>
			<li>
				<label>normal community</label>
				<description>Our community is already sufficient to function, but we must strive for better.</description>
				<baseMoodEffect>2</baseMoodEffect>
			</li>
			<li>
				<label>big community</label>
				<description>Cool, there are so many of us! How about a couple more people?</description>
				<baseMoodEffect>4</baseMoodEffect>
			</li>
			<li>
				<label>very big community</label>
				<description>Our society is perfect!</description>
				<baseMoodEffect>8</baseMoodEffect>
			</li>
		</stages>
		<nullifyingTraitDegrees>
			<li>Recluse</li>
		</nullifyingTraitDegrees>
	</ThoughtDef>
