<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<IssueDef>
		<defName>GlobalStructureBuilding</defName>
		<label>World building</label>
		<iconPath>Core/UI/Issues/GlobalStructureBuilding</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>GlobalStructureBuilding_Exalted</defName>
		<issue>GlobalStructureBuilding</issue>
		<label>Exalted</label>
		<description>We must show the whole world what we are worth!</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>Proselytizer</li>
		</associatedMemes>
		<comps>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>GlobalStructureBuilt</eventDef>
				<thought>GlobalStructureBuilt_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_GainCultureByEventArg">
				<eventDef>GlobalStructureBuilt</eventDef>
				<arg>CulturalSiteWorker_CulturePoints</arg>
				<mult>2</mult>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>GlobalStructureBuiltSomeoneVisited</eventDef>
				<thought>GlobalStructureBuiltSomeoneVisited_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_GainCultureByEventArg">
				<eventDef>GlobalStructureBuiltSomeoneVisited</eventDef>
				<arg>CulturalSiteWorker_CaravanAIArrived</arg>
				<mult>2</mult>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>GlobalStructureBuilt_Exalted</defName>
		<durationDays>15</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>world structure built</label>
				<description>Everyone can see our greatness in person!</description>
				<baseMoodEffect>12</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>GlobalStructureBuiltSomeoneVisited_Exalted</defName>
		<durationDays>5</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>someone visited our building</label>
				<description>Amazing! Our architecture is popular!</description>
				<baseMoodEffect>2</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<!---->
