	<ThoughtDef>
		<defName>GlobalStructureBuilt_Encouraged</defName>
		<durationDays>10</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>world structure built</label>
				<description>They will see our splendor.</description>
				<baseMoodEffect>9</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>GlobalStructureBuiltSomeoneVisited_Encouraged</defName>
		<durationDays>3</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>someone visited our building</label>
				<description>It's great that our efforts did not go unnoticed.</description>
				<baseMoodEffect>1</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
