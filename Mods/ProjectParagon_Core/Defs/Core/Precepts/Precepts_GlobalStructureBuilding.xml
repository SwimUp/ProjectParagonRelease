		<defName>GlobalStructureBuilding_Encouraged</defName>
		<issue>GlobalStructureBuilding</issue>
		<label>Encouraged</label>
		<description>Our greatness is inextricably linked to what we build.</description>
		<impact>Medium</impact>
		<displayOrderInIssue>20</displayOrderInIssue>
