				<arg>CulturalSiteWorker_CulturePoints</arg>
				<mult>1.5</mult>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>GlobalStructureBuiltSomeoneVisited</eventDef>
				<thought>GlobalStructureBuiltSomeoneVisited_Encouraged</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_GainCultureByEventArg">
				<eventDef>GlobalStructureBuiltSomeoneVisited</eventDef>
