<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<IssueDef>
		<defName>Quest</defName>
		<label>Quest</label>
		<iconPath>Core/UI/Issues/Quest</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>Quest_Exalted</defName>
		<issue>Quest</issue>
		<label>Exalted</label>
		<description>The tasks of strangers are a source of wisdom and life experience.</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>HAR_Xenophilia</li>
		</associatedMemes>
		<comps>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>QuestSuccess</eventDef>
				<thought>QuestSuccess_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>QuestFail</eventDef>
				<thought>QuestFail_Exalted</thought>
			</li>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>QuestSuccessPawn</eventDef>
				<thought>QuestSuccess_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>QuestSuccessPawn</eventDef>
				<thought>QuestSuccess_Know_Exalted</thought>
			</li>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>QuestFailPawn</eventDef>
				<thought>QuestFail_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>QuestFailPawn</eventDef>
				<thought>QuestFail_Know_Exalted</thought>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>QuestSuccess_Exalted</defName>
		<durationDays>7</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>quest successfully completed</label>
				<description>Mutually beneficial exchange is wonderful. It's worth doing this more often.</description>
				<baseMoodEffect>8</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>QuestFail_Exalted</defName>
		<durationDays>7</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>quest fail</label>
				<description>Yes, we showed ourselves on the bad side...</description>
				<baseMoodEffect>-6</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>QuestSuccess_Know_Exalted</defName>
		<thoughtClass>Thought_MemorySocial</thoughtClass>
		<durationDays>7</durationDays>
		<stackLimit>100</stackLimit>
		<stackLimitForSameOtherPawn>3</stackLimitForSameOtherPawn>
		<stages>
			<li>
				<label>quest successfully completed</label>
				<baseOpinionOffset>10</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>QuestFail_Know_Exalted</defName>
		<thoughtClass>Thought_MemorySocial</thoughtClass>
		<durationDays>7</durationDays>
		<stackLimit>100</stackLimit>
		<stackLimitForSameOtherPawn>3</stackLimitForSameOtherPawn>
		<stages>
			<li>
				<label>quest fail</label>
				<baseOpinionOffset>-10</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>
