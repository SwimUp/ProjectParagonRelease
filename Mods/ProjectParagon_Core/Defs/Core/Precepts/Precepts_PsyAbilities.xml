<Defs>
	<!---->
	<IssueDef>
		<defName>PsyAbilities</defName>
		<label>Psy abilities</label>
		<iconPath>Core/UI/Issues/PsyAbilities</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>PsyAbilities_Exalted</defName>
		<issue>PsyAbilities</issue>
		<label>Exalted</label>
		<description>Psionics are real wizards! Becoming a psionicist is a real dream.</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>Ritualist</li>
			<li>Blindsight</li>
		</associatedMemes>
		<requiredMemes>
			<li>Ritualist</li>
			<li>Blindsight</li>
		</requiredMemes>
		<comps>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>PsyLevelGain</eventDef>
				<thought>PsyLevelGain_Exalted</thought>
			</li>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>PsycastUsed</eventDef>
				<thought>PsycastUsed_Exalted</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>HasPsylink_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAllKilledPsionic">
				<eventDef>PawnKilled</eventDef>
				<thought>KilledPsionic_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>PsyLevelGain</eventDef>
				<thought>PsyLevelGain_Know_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>PsycastUsed</eventDef>
				<thought>PsycastUsed_Know_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_GainCultureByPsyLevel">
				<eventDef>PsyLevelGain</eventDef>
				<arg>Hediff_Psylink_ChangeLevel</arg>
				<mult>2</mult>
				<curvePointsByTechLevel>
					<points>
						<!-- None -->
						<li>0, 0.5</li>
						<!-- Племя -->
						<li>1, 0.5</li>
						<!-- Средневековье -->
						<li>2, 0.75</li>
						<!-- Индастриал -->
						<li>3, 1</li>
						<!-- Космос -->
						<li>4, 1.5</li>
						<!-- Ультра -->
						<li>5, 2</li>
					</points>
				</curvePointsByTechLevel>
				<curvePointsByPsyLevel>
					<points>
						<li>0, 25</li>
						<li>6, 100</li>
					</points>
				</curvePointsByPsyLevel>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>PsyLevelGain_Know_Exalted</defName>
		<thoughtClass>Thought_MemorySocial</thoughtClass>
		<durationDays>10</durationDays>
		<stackLimit>100</stackLimit>
		<stackLimitForSameOtherPawn>5</stackLimitForSameOtherPawn>
		<stages>
			<li>
				<label>psy level changed</label>
				<baseOpinionOffset>10</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>PsycastUsed_Know_Exalted</defName>
		<thoughtClass>Thought_MemorySocial</thoughtClass>
		<durationDays>10</durationDays>
		<stackLimit>100</stackLimit>
		<stackLimitForSameOtherPawn>5</stackLimitForSameOtherPawn>
		<stages>
			<li>
				<label>psycast used</label>
				<baseOpinionOffset>5</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>HasPsylink_Exalted</defName>
		<workerClass>ProjectParagon.Core.Thoughts.ThoughtWorker_Precept_AlwaysActive_HasPsylink</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>has not psylink</label>
				<description>I'm nothing!</description>
				<baseMoodEffect>-6</baseMoodEffect>
			</li>
			<li>
				<label>has psylink</label>
				<description>I'm stronger than you!</description>
				<baseMoodEffect>2</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>PsyLevelGain_Exalted</defName>
		<durationDays>10</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>psy level changed</label>
				<description>I'm one step closer to full power!</description>
				<baseMoodEffect>8</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>PsycastUsed_Exalted</defName>
		<durationDays>1</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>psycast used</label>
				<description>Feel my power!</description>
				<baseMoodEffect>2</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>KilledPsionic_Exalted</defName>
		<durationDays>7</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>psionic killed</label>
				<description>We killed a great man...</description>
				<baseMoodEffect>-3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
