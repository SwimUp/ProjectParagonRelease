<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<IssueDef>
		<defName>RecreatingAncientAnimals</defName>
		<label>Recreating ancient animals</label>
		<iconPath>Core/UI/Issues/RecreatingAncientAnimals</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>RecreatingAncientAnimals_Admiration</defName>
		<issue>RecreatingAncientAnimals</issue>
		<label>Admiration</label>
		<description>This is simply incredible! To see living creatures that have long been extinct. A real miracle!</description>
		<impact>Medium</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>HAR_Xenophilia</li>
			<li>Transhumanist</li>
		</associatedMemes>
		<conflictingMemes>
			<li>HAR_Xenophobia</li>
		</conflictingMemes>
		<comps>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>AnimalRecreated</eventDef>
				<thought>AnimalRecreated_Admiration</thought>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>AnimalRecreated_Admiration</defName>
		<durationDays>10</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>animal recreated</label>
				<description>This is simply incredible!</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
		</stages>
		<nullifyingTraitDegrees>
			<HAR_Xenophobia>1</HAR_Xenophobia>
