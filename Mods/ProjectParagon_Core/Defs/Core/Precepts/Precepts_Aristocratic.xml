	<PreceptDef>
		<defName>Aristocratic_Exalted</defName>
		<issue>Aristocratic</issue>
		<label>Exalted</label>
		<description>Only the truly worthy can bear noble titles, and we cannot stand aside!</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>Nobility</li>
		</associatedMemes>
		<conflictingMemes>
			<li>Isolationism</li>
		</conflictingMemes>
		<comps>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAllKilledTitled">
				<eventDef>PawnKilled</eventDef>
				<thought>KilledTitled_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>ReceivedNobleTitle</eventDef>
				<thought>ReceivedNobleTitle_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_GainCultureByTitle">
				<eventDef>ReceivedNobleTitle</eventDef>
				<arg>TryUpdateTitle_Seniority</arg>
				<mult>1</mult>
				<curvePointsByTechLevel>
					<points>
						<!-- None -->
						<li>0, 0.5</li>
						<!-- Племя -->
						<li>1, 0.5</li>
						<!-- Средневековье -->
						<li>2, 0.75</li>
						<!-- Индастриал -->
						<li>3, 1</li>
						<!-- Космос -->
						<li>4, 1.5</li>
						<!-- Ультра -->
						<li>5, 2</li>
					</points>
				</curvePointsByTechLevel>
				<curvePointsByTitle>
					<points>
						<!-- Default -->
						<li>0, 50</li>
						<!-- Freeholder -->
						<li>0, 50</li>
						<!-- Yeoman -->
						<li>100, 75</li>
						<!-- Acolyte -->
						<li>200, 100</li>
						<!-- Knight -->
						<li>300, 150</li>
						<!-- Praetor -->
						<li>400, 200</li>
						<!-- Baron -->
						<li>500, 250</li>
						<!-- Count -->
						<li>600, 300</li>
						<!-- Duke -->
						<li>700, 400</li>
						<!-- Consul -->
						<li>800, 500</li>
						<!-- Stellarch -->
						<li>900, 750</li>
						<!-- Emperor -->
						<li>1000, 1000</li>
					</points>
				</curvePointsByTitle>
			</li>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>ReceivedNobleTitle</eventDef>
				<thought>ReceivedNobleTitle_ForMe_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>ReceivedNobleTitle</eventDef>
				<thought>ReceivedNobleTitle_Know_Exalted</thought>
			</li>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>ReceivedFavor</eventDef>
				<thought>ReceivedFavor_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>ReceivedFavor</eventDef>
				<thought>ReceivedFavor_Know_Exalted</thought>
			</li>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>LostFavor</eventDef>
				<thought>LostFavor_Exalted</thought>
			</li>
			<li Class="PreceptComp_KnowsMemoryThought">
				<eventDef>LostFavor</eventDef>
				<thought>LostFavor_Know_Exalted</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>EmpireRelations_Exalted</thought>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>EmpireRelations_Exalted</defName>
		<workerClass>ProjectParagon.Core.Thoughts.ThoughtWorker_Precept_AlwaysActive_EmpireRelations</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Child, Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>empire is hostile</label>
				<description>This is some kind of terrible mistake! We cannot fight the crown!</description>
				<baseMoodEffect>-8</baseMoodEffect>
			</li>
			<li>
				<label>empire is neutral</label>
				<description>We should show the empire our desire to cooperate!</description>
				<baseMoodEffect>-2</baseMoodEffect>
			</li>
			<li>
				<label>empire is ally</label>
				<description>This is exactly how it should be forever and ever.</description>
				<baseMoodEffect>5</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
