		<iconPath>Core/UI/Issues/DestructiveWeapon</iconPath>
	</IssueDef>
	<!---->
	<PreceptDef>
		<defName>DestructiveWeapon_Exalted</defName>
		<issue>DestructiveWeapon</issue>
		<label>Exalted</label>
		<description>Let's just launch a bomb at our enemies!</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<conflictingMemes>
			<li>NaturePrimacy</li>
		</conflictingMemes>
		<associatedMemes>
			<li>Supremacist</li>
			<li>Raider</li>
		</associatedMemes>
		<comps>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>NuclearWeaponUsed</eventDef>
				<thought>DestructiveWeaponUsed_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_GainCulture">
				<eventDef>NuclearWeaponUsed</eventDef>
				<curvePointsByTechLevel>
					<points>
						<!-- None -->
						<li>0, 50</li>
						<!-- Племя -->
						<li>1, 50</li>
						<!-- Средневековье -->
						<li>2, 75</li>
						<!-- Индастриал -->
						<li>3, 100</li>
						<!-- Космос -->
						<li>4, 125</li>
						<!-- Ультра -->
						<li>5, 150</li>
					</points>
				</curvePointsByTechLevel>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>NuclearWeaponResearched</eventDef>
				<thought>DestructiveWeaponResearched_Exalted</thought>
			</li>
			<li Class="ProjectParagon.Core.Precepts.PreceptComp_MemoryForAll">
				<eventDef>NuclearWeaponBuilt</eventDef>
				<thought>DestructiveWeaponBuilt_Exalted</thought>
			</li>
		</comps>
	</PreceptDef>
	<ThoughtDef>
		<defName>DestructiveWeaponUsed_Exalted</defName>
		<durationDays>12</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>destructive weapon used</label>
				<description>Booooooom!</description>
				<baseMoodEffect>7</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>DestructiveWeaponResearched_Exalted</defName>
		<durationDays>8</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>destructive weapon researched</label>
				<description>I can't wait to use this!</description>
				<baseMoodEffect>2</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>DestructiveWeaponBuilt_Exalted</defName>
		<durationDays>7</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>destructive weapon built</label>
				<description>All that remains is to launch it. Forward!</description>
				<baseMoodEffect>4</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
