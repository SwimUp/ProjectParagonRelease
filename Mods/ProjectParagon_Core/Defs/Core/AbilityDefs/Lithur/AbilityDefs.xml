<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!---->
	<AbilityDef>
		<defName>PiercingGaze</defName>
		<label>Piercing gaze</label>
		<description>Paralyzes the victim with just one glance. The duration of the effect depends on the suppressibility of the target. The range of action is proportional to the pawn's vision.</description>
		<abilityClass>ProjectParagon.Core.Things.Pawns.Ability_PiercingGaze</abilityClass>
		<!--<gizmoClass>ProjectParagon.Core.Things.Pawns.Command_AbilityParagon</gizmoClass>-->
		<iconPath>Core/Genes/PiercingGaze</iconPath>
		<writeCombatLog>True</writeCombatLog>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<groupDef>Lithur</groupDef>
		<overrideGroupCooldown>True</overrideGroupCooldown>
		<cooldownTicksRange>30000</cooldownTicksRange>
		<aiCanUse>true</aiCanUse>
		<statBases>
			<Ability_Duration>5</Ability_Duration>
		</statBases>
		<warmupSound>PsycastCastLoop</warmupSound>
		<verbProperties>
			<verbClass>ProjectParagon.Core.Things.Pawns.Verb_PiercingGaze</verbClass>
			<range>5</range>
			<requireLineOfSight>True</requireLineOfSight>
			<warmupTime>1</warmupTime>
			<targetParams>
				<canTargetBuildings>False</canTargetBuildings>
				<canTargetAnimals>true</canTargetAnimals>
				<thingCategory>Item</thingCategory>
				<mapObjectTargetsMustBeAutoAttackable>False</mapObjectTargetsMustBeAutoAttackable>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="CompProperties_AbilityEffectWithDuration">
				<compClass>CompAbilityEffect_Stun</compClass>
				<durationMultiplier>Suppressability</durationMultiplier>
				<psychic>True</psychic>
				<goodwillImpact>-15</goodwillImpact>
			</li>
			<li Class="CompProperties_AbilityFleckOnTarget">
				<fleckDef>PsycastPsychicEffect</fleckDef>
			</li>
		</comps>
	</AbilityDef>
	<!---->
	<AbilityDef>
		<defName>XRaySight</defName>
		<label>X-ray sight</label>
		<description>Allows you to analyze nearby rocks in search of valuable resources.</description>
		<abilityClass>ProjectParagon.Core.Things.Pawns.Ability_XRaySight</abilityClass>
		<!--<gizmoClass>ProjectParagon.Core.Things.Pawns.Command_AbilityParagon</gizmoClass>-->
		<iconPath>Core/Genes/XRaySight</iconPath>
		<writeCombatLog>True</writeCombatLog>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<groupDef>Lithur</groupDef>
		<overrideGroupCooldown>True</overrideGroupCooldown>
		<cooldownTicksRange>30000</cooldownTicksRange>
		<jobDef>CastAbilityOnThingUninterruptible</jobDef>
		<targetRequired>False</targetRequired>
		<canUseAoeToGetTargets>False</canUseAoeToGetTargets>
		<showPsycastEffects>False</showPsycastEffects>
		<verbProperties>
			<verbClass>ProjectParagon.Core.Things.Pawns.Verb_XRaySight</verbClass>
			<warmupTime>1.5</warmupTime>
			<range>5</range>
			<drawAimPie>true</drawAimPie>
			<requireLineOfSight>False</requireLineOfSight>
			<targetParams>
				<canTargetSelf>True</canTargetSelf>
			</targetParams>
		</verbProperties>
	</AbilityDef>
	<!---->
	<AbilityDef ParentName="PsycastBase">
		<defName>FireWave</defName>
		<label>Fire wave</label>
		<description>The psionicist excites space with a psionic wave, which leads to combustion, pursuing the victim.</description>
		<!--<gizmoClass>ProjectParagon.Core.Things.Pawns.Command_AbilityPsycastParagon</gizmoClass>-->
		<level>1</level>
		<statBases>
			<Ability_EntropyGain>45</Ability_EntropyGain>
			<Ability_PsyfocusCost>0.05</Ability_PsyfocusCost>
		</statBases>
		<jobDef>CastAbilityOnThing</jobDef>
		<targetRequired>False</targetRequired>
		<canUseAoeToGetTargets>False</canUseAoeToGetTargets>
		<iconPath>Core/UI/Abilities/FireWave</iconPath>
		<stunTargetWhileCasting>True</stunTargetWhileCasting>
		<showPsycastEffects>False</showPsycastEffects>
		<displayGizmoWhileUndrafted>False</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
		<warmupStartSound>CombatCommand_Warmup</warmupStartSound>
		<aiCanUse>true</aiCanUse>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<warmupTime>0.5</warmupTime>
			<range>10</range>
			<drawAimPie>False</drawAimPie>
			<requireLineOfSight>False</requireLineOfSight>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
				<canTargetPawns>false</canTargetPawns>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetAnimals>false</canTargetAnimals>
				<canTargetHumans>false</canTargetHumans>
				<canTargetMechs>false</canTargetMechs>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="CompProperties_AbilityEffectWithDuration">
				<compClass>ProjectParagon.Core.Abilities.CompAbilityEffect_FireWave</compClass>
			</li>
		</comps>
		<modExtensions>
			<li Class="ProjectParagon.Core.Other.DefExtension_AbilityDef">
				<allowedRaces>
					<li>LithurRace</li>
				</allowedRaces>
			</li>
		</modExtensions>
	</AbilityDef>
	<!---->
</Defs>