<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!---->
	<ThingDef ParentName="IdeoBuildingConsumableBase">
		<defName>BanquetDish</defName>
		<label>Banquet dish</label>
		<description>A large dish for a magnificent banquet.</description>
		<ideoBuildingNamerBase>NamerBanquetDish</ideoBuildingNamerBase>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Core/Food/Meals/BanquetDish/BanquetDish</texPath>
			<drawSize>3.5</drawSize>
		</graphicData>
		<minifiedDef>MinifiedThing</minifiedDef>
		<staticSunShadowHeight>0.2</staticSunShadowHeight>
		<size>(2,2)</size>
		<rotatable>false</rotatable>
		<costList>
			<RegularMeat>200</RegularMeat>
		</costList>
		<killedLeavings>
			<RegularMeat>200</RegularMeat>
		</killedLeavings>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<defaultPlacingRot>North</defaultPlacingRot>
		<ritualFocus>
			<spectateDistance>1~2</spectateDistance>
		</ritualFocus>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<WorkToBuild>10000</WorkToBuild>
			<Mass>25</Mass>
		</statBases>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<passability>PassThroughOnly</passability>
		<placeWorkers Inherit="False"/>
	</ThingDef>
	<RulePackDef>
		<defName>NamerBanquetDish</defName>
		<rulePack>
			<rulesStrings>
				<li>buildingName->dish</li>
				<li>buildingName->feast</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>
	<!---->
</Defs>