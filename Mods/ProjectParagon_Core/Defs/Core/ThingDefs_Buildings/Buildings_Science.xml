	<ThingDef ParentName="BuildingBase">
		<defName>HadronColliderCore</defName>
		<label>Hadron Collider (Core)</label>
		<description>The core of the hadron collider, which is used to launch and study particles.</description>
		<thingClass>ProjectParagon.Core.Things.Building_HadronColliderCore</thingClass>
		<graphicData>
			<texPath>Core/Buildings/HadronCollider/HadronColliderCore</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3.3,3.3)</drawSize>
			<drawRotated>false</drawRotated>
			<shadowData>
				<volume>(2,1,2)</volume>
				<offset>(0,0,-0.4)</offset>
			</shadowData>
			<damageData>
				<rect>(0.3,0.1,2.4,1.8)</rect>
			</damageData>
		</graphicData>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>500</costStuffCount>
		<costList>
			<Nanoelectronics>5</Nanoelectronics>
			<ComponentSpacer>10</ComponentSpacer>
			<MechanismSpacer>10</MechanismSpacer>
			<SuperStrongPlates>200</SuperStrongPlates>
			<CinderBlock>250</CinderBlock>
		</costList>
		<altitudeLayer>BuildingBelowTop</altitudeLayer>
		<useHitPoints>True</useHitPoints>
		<drawerType>RealtimeOnly</drawerType>
		<statBases>
			<WorkToBuild>75000</WorkToBuild>
			<MaxHitPoints>300</MaxHitPoints>
			<Beauty>-4</Beauty>
		</statBases>
		<size>(3,3)</size>
		<rotatable>true</rotatable>
		<designationCategory>Science</designationCategory>
		<fillPercent>1</fillPercent>
		<passability>Impassable</passability>
		<surfaceType>Item</surfaceType>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<constructionSkillPrerequisite>14</constructionSkillPrerequisite>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<interactionCellIcon>DiningChair</interactionCellIcon>
		<placeWorkers>
			<li>ProjectParagon.Core.Things.PlaceWorker_ModularBuilding</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<forceShowRoomStats>true</forceShowRoomStats>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>ProjectParagon.Core.Things.CompPowerTraderParagon</compClass>
				<basePowerConsumption>5000</basePowerConsumption>
				<shortCircuitInRain>true</shortCircuitInRain>
			</li>
			<li Class="ProjectParagon.Core.Things.CompProperties_ModularBuilding">
				<scheme>HadronCollider</scheme>
			</li>
			<li Class="CompProperties_Flickable"/>
		</comps>
		<researchPrerequisites>
			<li>HadronCollider</li>
		</researchPrerequisites>
	</ThingDef>
	
