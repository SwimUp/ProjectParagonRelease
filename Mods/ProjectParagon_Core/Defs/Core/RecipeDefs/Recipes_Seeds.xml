<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<RecipeDef Name="MakeSeedParagonBase" Abstract="true">
		<description>Make plant seeds from its fruits.</description>
		<jobString>Making seeds.</jobString>
		<workAmount>600</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<requiredGiverWorkType>PlantCutting</requiredGiverWorkType>
		<effectWorking>Harvest_Plant</effectWorking>
		<allowMixingIngredients>true</allowMixingIngredients>
		<workSkill>Plants</workSkill>
		<recipeUsers>
			<li>PlantProcessingTable</li>
		</recipeUsers>
	</RecipeDef>
	
	<RecipeDef ParentName="MakeSeedParagonBase">
		<defName>Make_MeatBushSeeds</defName>
		<label>make meat bush seeds</label>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>RegularMeat</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>UraniumPowder</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<products>
			<SeedMeatBush>4</SeedMeatBush>
		</products>
		<researchPrerequisite>Agro_MutatedPlantsI</researchPrerequisite>
	</RecipeDef>
	
	<RecipeDef>
		<defName>BurnSeeds</defName>
		<label>burn seeds</label>
		<description>Burn seeds.</description>
		<jobString>burning seeds.</jobString>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<workAmount>50</workAmount>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>SeedsCategory</li>
					</categories>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<products>
		</products>
		<fixedIngredientFilter>
			<categories>
				<li>SeedsCategory</li>
			</categories>
		</fixedIngredientFilter>
		<workSkill>Crafting</workSkill>
		<recipeUsers>
			<li>MeltingFurnace</li>
			<li>Crucible</li>
			<li>Campfire</li>
			<li>CookingFurnace</li>
			<li>FueledStove</li>
			<li>ElectricStove</li>
			<li>SteamSmelter</li>
			<li>ElectricSmelter</li>
			<li>ArcSmelter</li>
			<li>VacuumSmelter</li>
		</recipeUsers>
	</RecipeDef>
	<RecipeDef>
		<defName>BurnSeedsBulk</defName>
		<label>burn seeds x10</label>
		<description>Burn seeds.</description>
		<jobString>burning seeds.</jobString>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<workAmount>500</workAmount>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>SeedsCategory</li>
					</categories>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<products>
		</products>
		<fixedIngredientFilter>
			<categories>
				<li>SeedsCategory</li>
			</categories>
		</fixedIngredientFilter>
		<workSkill>Crafting</workSkill>
		<recipeUsers>
			<li>MeltingFurnace</li>
			<li>Crucible</li>
			<li>Campfire</li>
			<li>CookingFurnace</li>
			<li>FueledStove</li>
			<li>ElectricStove</li>
			<li>SteamSmelter</li>
			<li>ElectricSmelter</li>
			<li>ArcSmelter</li>
			<li>VacuumSmelter</li>
		</recipeUsers>
	</RecipeDef>
	
</Defs>
