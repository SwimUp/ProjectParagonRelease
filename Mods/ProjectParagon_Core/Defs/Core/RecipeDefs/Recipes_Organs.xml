	<RecipeDef Class="ProjectParagon.Core.Recipes.ExtendedRecipeDef">
		<defName>Make_Kidney</defName>
		<label>make kidney</label>
		<description>Make kidney.</description>
		<jobString>Making kidney.</jobString>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<workAmount>5000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Biosynthetics</li>
					</thingDefs>
				</filter>
				<count>175</count>
			</li>
		</ingredients>
		<abstractIngredients>
			<li Class="ProjectParagon.Core.Recipes.IngredientCountParagon_Liquid">
				<pipeTypeDef>CarbonDioxide</pipeTypeDef>
				<count>25</count>
			</li>
			<li Class="ProjectParagon.Core.Recipes.IngredientCountParagon_Water">
				<count>10</count>
			</li>
		</abstractIngredients>
		<products>
			<Kidney>1</Kidney>
		</products>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Biosynthetics</li>
			</thingDefs>
		</fixedIngredientFilter>
		<researchPrerequisite>OrgansPrinting</researchPrerequisite>
		<skillRequirements>
			<Crafting>12</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
		<recipeUsers>
			<li>Bioprinter</li>
		</recipeUsers>
	</RecipeDef>
