<Defs>
	<!---->
	<RecipeDef Class="ProjectParagon.Core.Recipes.ExtendedRecipeDef">
		<defName>Make_BattleBook</defName>
		<label>make battle book</label>
		<description>Make battle book.</description>
		<jobString>Making battle book.</jobString>
		<workerClass>ProjectParagon.Core.Recipes.RecipeWorker_MakeBook</workerClass>
		<unfinishedThingDef>UnfinishedBook</unfinishedThingDef>
		<workSpeedStat>ReadingSpeed</workSpeedStat>
		<effectWorking>Tailor</effectWorking>
		<soundWorking>Recipe_Tailor</soundWorking>
		<workAmount>50000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Paper</li>
					</thingDefs>
				</filter>
				<count>75</count>
			</li>
		</ingredients>
		<abstractIngredients>
			<li Class="ProjectParagon.Core.Recipes.IngredientCountParagon_SpecXp">
				<count>1</count>
			</li>
		</abstractIngredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Paper</li>
			</thingDefs>
		</fixedIngredientFilter>
		<researchPrerequisite>GamesII</researchPrerequisite>
		<skillRequirements>
			<Intellectual>6</Intellectual>
		</skillRequirements>
		<workSkill>Intellectual</workSkill>
		<recipeUsers>
			<li>WriterTable</li>
		</recipeUsers>
		<modExtensions>
			<li Class="ProjectParagon.Core.Recipes.DefModExtension_RecipeMakeBook">
				<bookDef>BattleBook</bookDef>
			</li>
		</modExtensions>
	</RecipeDef>
