<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[@Name="BasePawn"]/inspectorTabs</xpath>
				<value>
					<inspectorTabs>
						<li>ITab_Pawn_Health</li>
						<li>ITab_Pawn_Needs</li>
						<li>ITab_Pawn_Character</li>
						<li>ProjectParagon.Core.FightSystem.ITab_Pawn_WeaponSpecs</li>
						<li>ITab_Pawn_Training</li>
						<li>ITab_Pawn_Social</li>
						<li>ITab_Pawn_Guest</li>
						<li>ITab_Pawn_Prisoner</li>
						<!--<li>ProjectParagon.Core.ITabs.ITab_Pawn_PrisonerParagon</li>-->
						<li MayRequire="Ludeon.RimWorld.Ideology">ITab_Pawn_Slave</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">ITab_Pawn_Feeding</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">ITab_Genes</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">ITab_GenesPregnancy</li>
						<li MayRequire="Ludeon.RimWorld.Anomaly">ITab_Entity</li>
						<li>ITab_Pawn_FormingCaravan</li>
						<li>CombatExtended.ITab_Inventory</li>
						<li>ITab_Pawn_Log</li>
					</inspectorTabs>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[@Name="BasePawn"]/comps</xpath>
				<value>
					<li Class="ProjectParagon.Core.Things.Pawns.CompProperties_PawnParagon"/>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="Human"]/recipes</xpath>
				<value>
					<li>Lobotomy</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="Human"]/modExtensions</xpath>
				<value>
					<li Class="ProjectParagon.Core.Things.RacePropertiesDefModExtension">
						<xenosHediffFilter>
						</xenosHediffFilter>
						<defaultRaceLanguage>Human</defaultRaceLanguage>
					</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="Human"]</xpath>
				<value>
					<thingCategories>
						<li>Pawns</li>
					</thingCategories>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="Human"]/race/hediffGiverSets</xpath>
				<value>
					<li>OrganicHumanlikeGroup</li>
				</value>
			</li>
			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[@Name="BaseMechanoid"]</xpath>
				<value>
					<li Class="ProjectParagon.Core.Things.RacePropertiesDefModExtension">
						<defaultRaceLanguage>LinguaTechnis</defaultRaceLanguage>
					</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[@Name="AnimalThingBase"]/race</xpath>
				<value>
					<willNeverEat>
						<li>WoodLog</li>
						<li>Coal</li>
						<li>CokeCoal</li>
						<li>FuelBriquette</li>
						<li>Chemfuel</li>
						<li>Canister_Naphtha</li>
						<li>Canister_Diesel</li>
						<li>Canister_HeavyOil</li>
						<li>Canister_MediumOil</li>
						<li>Canister_LightOil</li>
						<li>Canister_Oil</li>
						<li>UraniumPowder</li>
						<li>UraniumPellets</li>
						<li>Plutonium</li>
						<li>DepletedUraniumPellets</li>
						<li>FuelRods</li>
						<li>FuelRodsMOX</li>
						<li>NuclearWaste</li>
						<li>Sulfur</li>
						<li>Sand</li>
						<li>Clay</li>
						<li>Slag</li>
						<li>Silicon</li>
						<li>ChunkSandstone</li>
						<li>ChunkGranite</li>
						<li>ChunkLimestone</li>
						<li>ChunkSlate</li>
						<li>ChunkMarble</li>
						<li>BlocksSandstone</li>
						<li>BlocksGranite</li>
						<li>BlocksLimestone</li>
						<li>BlocksSlate</li>
						<li>BlocksMarble</li>
					</willNeverEat>
				</value>
			</li>
			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[defName="Wolf_Timber"]</xpath>
				<value>
					<li Class="GiddyUp.DrawingOffset">
						<northOffset>(0.0, 0.0, 0.0)</northOffset>
						<southOffset>(0.0, 0.0, 0.0)</southOffset>
						<eastOffset>(0.0, 0.0, 0.3)</eastOffset>
						<westOffset>(0.0, 0.0, 0.3)</westOffset>
					</li>
				</value>
			</li>
			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[defName="Wolf_Arctic"]</xpath>
				<value>
					<li Class="GiddyUp.DrawingOffset">
						<northOffset>(0.0, 0.0, 0.0)</northOffset>
						<southOffset>(0.0, 0.0, 0.0)</southOffset>
						<eastOffset>(0.0, 0.0, 0.3)</eastOffset>
						<westOffset>(0.0, 0.0, 0.3)</westOffset>
					</li>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>
