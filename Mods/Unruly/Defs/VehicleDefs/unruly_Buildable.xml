<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>unruly_Blueprint</defName>
		<label>不羁浪子</label>
		<description>虽然这辆车的设计已经足够过时，但也不得否认这辆车在公路上行驶的魅力，它那古老但充满动力的V8引擎使它具有较高的最高时速，但较重的车身地盘使其加速度较慢，也使它更坚固，更能装载货物。\n\n&lt;color=#bb8f04&gt;乘员:&lt;/color&gt; 驾驶员 x1, 乘客 x1\n&lt;color=#bb8f04&gt;动力:&lt;/color&gt; 化合燃料</description>
		<designationCategory>VF_Vehicles</designationCategory>
		<graphicData>
			<texPath>Things/Vehicles/unruly/unruly</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,5)</drawSize>
		</graphicData>
		
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToBuild>26000</WorkToBuild>
			<Flammability>0.05</Flammability>
		</statBases>
		
		<size>(2,4)</size>
		
		<constructionSkillPrerequisite>15</constructionSkillPrerequisite>	
		<researchPrerequisites Inherit="False">
			<li>MediumEngineering</li>
		</researchPrerequisites>
		
		<costList>
			<UpgradedMediumEngine>1</UpgradedMediumEngine>
			<ComponentHeavyCasting>20</ComponentHeavyCasting>
			<ComponentWheelTire>4</ComponentWheelTire>
			<SimplePlates>60</SimplePlates>
			<StrongPlates>45</StrongPlates>
		</costList>
		
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		
		<thingToSpawn>unruly</thingToSpawn>
		
	</Vehicles.VehicleBuildDef>
</Defs>
