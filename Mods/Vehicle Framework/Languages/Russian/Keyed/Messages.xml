  <!-- EN: {0} is no longer able to operate their role for the vehicle caravan. -->
	<VF_VehicleCaravanMentalBreakMovementRole>{0} больше не может выполнять свою роль в транспортном караване.</VF_VehicleCaravanMentalBreakMovementRole>
