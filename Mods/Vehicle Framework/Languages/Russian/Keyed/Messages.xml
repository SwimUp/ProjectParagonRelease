	<VF_CantAssignVehicle>Недостаточно экипажа для {0}.</VF_CantAssignVehicle>
  <!-- EN: Failed to assign seats. {0} -->
	<VF_AssignFailure>Не удалось распределить места. {0}</VF_AssignFailure>
