<?xml version="1.0" encoding="utf-8"?>

<LanguageData>
  <!-- Color Picker -->
  <!-- EN: Must have a palette selected to save over. -->
	<VF_MustSelectColorPalette>Для сохранения необходимо выбрать расцветку.</VF_MustSelectColorPalette>

  <!-- Vehicles -->
  <!-- EN: {0_labelShort} is unable to move. -->
	<VF_VehicleUnableToMove>{0_labelShort} не может передвигаться.</VF_VehicleUnableToMove>
