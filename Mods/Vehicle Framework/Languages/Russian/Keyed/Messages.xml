	<VF_NoAmmoLoadedTurret>Боеприпасы не загружены.</VF_NoAmmoLoadedTurret>
  <!-- EN: No ammo available in inventory. -->
	<VF_NoAmmoAvailable>В инвентаре нет боеприпасов.</VF_NoAmmoAvailable>

