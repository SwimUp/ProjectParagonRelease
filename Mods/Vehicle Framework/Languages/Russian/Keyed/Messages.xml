  <!-- EN: {0} has arrived at their destination. -->
	<VF_AerialVehicleArrived>{0} прибыл в пункт назначения.</VF_AerialVehicleArrived>
  <!-- EN: {0} has left the map. -->
	<VF_AerialVehicleLeft>{0} покинул карту.</VF_AerialVehicleLeft>
