			<categories>
				<li>Alloys_Strong</li>
				<li>Alloys_Superalloys</li>
			</categories>
			<thingDefs>
				<li>TungstenIngot</li>
				<li>SmokelessGunpowder</li>
				<li>BrassIngot</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_300AACBlackout_FMJ_Pulsed>150</Ammo_300AACBlackout_FMJ_Pulsed>
		</products>
		<workAmount>1400</workAmount>
		<recipeUsers Inherit="false">
			<li>RoboticEquipmentWorkbench</li>
		</recipeUsers>
		<researchPrerequisite>ChargedShot</researchPrerequisite>
	</RecipeDef>

