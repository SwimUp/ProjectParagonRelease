<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="ArmorSmithableBase" Name="ShieldBase" Abstract="true">
		<thingClass>CombatExtended.Apparel_Shield</thingClass>
		<thingCategories>
			<li>Shields</li>
		</thingCategories>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<bodyPartGroups>
				<li>LeftShoulder</li>
			</bodyPartGroups>
			<layers>
				<li>Shield</li>
			</layers>
		</apparel>
		<storedConceptLearnOpportunity>CE_Shields</storedConceptLearnOpportunity>
		<smeltable>true</smeltable>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedShield</unfinishedThingDef>
		</recipeMaker>
	</ThingDef>
	<ThingDef Abstract="True" Name="Apparelo_Shield_FightSystem" ParentName="ShieldBase">
		<comps>
			<li Class="ProjectParagon.Core.FightSystem.CompProperties_SpecialAttacks">
				<specialAttacks>
					<li>ShieldBash_Shield</li>
				</specialAttacks>
			</li>
		</comps>
	</ThingDef>
	<ThingDef ParentName="Apparelo_Shield_FightSystem">
		<defName>CE_Apparel_MeleeShield</defName>
		<label>melee shield</label>
		<description>Simple shield that can block simple projectiles and hits with melee weapons.</description>
		<techLevel>Neolithic</techLevel>
		<graphicData>
			<texPath>Things/Apparel/Shield/CE_Shield</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<possessionCount>1</possessionCount>
		<costStuffCount>75</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
		</stuffCategories>
		<costList>
			<ComponentPrimitive>2</ComponentPrimitive>
		</costList>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Tailor</effectWorking>
			<soundWorking>Recipe_Tailor</soundWorking>
			<researchPrerequisite>SimpleWeapons</researchPrerequisite>
			<recipeUsers inherit="false">
				<li>ForgeWithAnvil</li>
				<li>BlacksmithFurnace</li>
				<li>FueledSmithy</li>
				<li>ElectricSmithy</li>
				<li>RoboticEquipmentWorkbench</li>
			</recipeUsers>
		</recipeMaker>
		<statBases>
			<WorkToMake>5000</WorkToMake>
			<MaxHitPoints>125</MaxHitPoints>
			<StuffEffectMultiplierArmor>2</StuffEffectMultiplierArmor>
			<Mass>3</Mass>
			<Bulk>5</Bulk>
			<WornBulk>5</WornBulk>
		</statBases>
		<equippedStatOffsets>
			<ReloadSpeed>-0.3</ReloadSpeed>
			<MeleeHitChance>-0.15</MeleeHitChance>
			<ShootingAccuracyPawn>-0.15</ShootingAccuracyPawn>
			<AimingAccuracy>-0.1</AimingAccuracy>
			<Suppressability>-0.15</Suppressability>
			<MeleeCritChance>-0.1</MeleeCritChance>
			<MeleeParryChance>1.0</MeleeParryChance>
		</equippedStatOffsets>
		<apparel>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<tags>
				<li>TribalShield</li>
			</tags>
		</apparel>
		<modExtensions>
			<li Class="CombatExtended.ShieldDefExtension">
				<shieldCoverage>
					<li>Hands</li>
					<li>Arms</li>
					<li>Shoulders</li>
					<li>Torso</li>
					<li>Neck</li>
				</shieldCoverage>
			</li>
		</modExtensions>
		<tradeTags>
			<li>Armor</li>
		</tradeTags>
	</ThingDef>
	<ThingDef ParentName="Apparelo_Shield_FightSystem">
		<defName>CE_Apparel_MeleeShieldMedieval</defName>
		<label>knight shield</label>
		<description>A durable shield that can block enemy attacks.</description>
		<techLevel>Medieval</techLevel>
		<graphicData>
			<texPath>Things/Apparel/Shield/ShieldMedieval</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<possessionCount>1</possessionCount>
		<costStuffCount>100</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
		</stuffCategories>
		<costList>
			<ComponentSimple>3</ComponentSimple>
		</costList>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Tailor</effectWorking>
			<soundWorking>Recipe_Tailor</soundWorking>
			<researchPrerequisite>PlateArmor</researchPrerequisite>
			<recipeUsers inherit="false">
				<li>ForgeWithAnvil</li>
				<li>FueledSmithy</li>
				<li>ElectricSmithy</li>
				<li>RoboticEquipmentWorkbench</li>
			</recipeUsers>
		</recipeMaker>
		<statBases>
			<WorkToMake>7000</WorkToMake>
			<MaxHitPoints>150</MaxHitPoints>
			<StuffEffectMultiplierArmor>3.5</StuffEffectMultiplierArmor>
			<Mass>5</Mass>
			<Bulk>6</Bulk>
			<WornBulk>6</WornBulk>
		</statBases>
		<equippedStatOffsets>
			<ReloadSpeed>-0.5</ReloadSpeed>
			<MeleeHitChance>-0.25</MeleeHitChance>
			<ShootingAccuracyPawn>-0.25</ShootingAccuracyPawn>
			<AimingAccuracy>-0.2</AimingAccuracy>
			<Suppressability>-0.25</Suppressability>
			<MeleeCritChance>-0.2</MeleeCritChance>
			<MeleeParryChance>1.0</MeleeParryChance>
		</equippedStatOffsets>
		<apparel>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<tags>
				<li>MedievalShield</li>
			</tags>
		</apparel>
		<modExtensions>
			<li Class="CombatExtended.ShieldDefExtension">
				<shieldCoverage>
					<li>Hands</li>
					<li>Arms</li>
					<li>Shoulders</li>
					<li>Torso</li>
					<li>Neck</li>
				</shieldCoverage>
			</li>
		</modExtensions>
		<tradeTags>
			<li>Armor</li>
		</tradeTags>
	</ThingDef>
	<ThingDef ParentName="Apparelo_Shield_FightSystem">
		<defName>CE_Apparel_BallisticShield</defName>
		<label>ballistic shield</label>
		<description>A heavy shield designed to protect against gunfire. It can cover most of the wearer's body but restricts use of two-handed weapons. Its heavy weight and bulk make it unwieldy in combat.</description>
		<techLevel>Industrial</techLevel>
		<graphicData>
			<texPath>Things/Apparel/BallisticShield/CE_BallisticShield</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<possessionCount>1</possessionCount>
		<costStuffCount>150</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costList>
			<ComponentSimple>4</ComponentSimple>
			<Kevlar>30</Kevlar>
		</costList>
		<recipeMaker>
			<researchPrerequisite>FlakArmorII</researchPrerequisite>
			<recipeUsers inherit="false">
				<li>FueledSmithy</li>
				<li>ElectricSmithy</li>
				<li>RoboticEquipmentWorkbench</li>
			</recipeUsers>
		</recipeMaker>
		<statBases>
			<WorkToMake>12000</WorkToMake>
			<MaxHitPoints>125</MaxHitPoints>
			<StuffEffectMultiplierArmor>8</StuffEffectMultiplierArmor>
			<Mass>10</Mass>
			<Bulk>10</Bulk>
			<WornBulk>10</WornBulk>
		</statBases>
		<equippedStatOffsets>
			<ReloadSpeed>-0.5</ReloadSpeed>
			<MeleeHitChance>-4</MeleeHitChance>
			<ShootingAccuracyPawn>-0.5</ShootingAccuracyPawn>
			<AimingAccuracy>-0.2</AimingAccuracy>
			<Suppressability>-0.5</Suppressability>
			<MeleeCritChance>-0.2</MeleeCritChance>
			<MeleeParryChance>1.0</MeleeParryChance>
		</equippedStatOffsets>
		<apparel>
			<tags>
				<li>OutlanderShield</li>
			</tags>
		</apparel>
		<modExtensions>
			<li Class="CombatExtended.ShieldDefExtension">
				<shieldCoverage>
					<li>Hands</li>
					<li>Arms</li>
					<li>Shoulders</li>
					<li>Torso</li>
					<li>Neck</li>
					<li>FullHead</li>
				</shieldCoverage>
				<crouchCoverage>
					<li>Legs</li>
				</crouchCoverage>
				<drawAsTall>true</drawAsTall>
			</li>
		</modExtensions>
		<tradeTags>
			<li>Armor</li>
		</tradeTags>
	</ThingDef>
</Defs>
