<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<Vehicles.VehicleBuildDef ParentName="RT_BaseVehicleBuild">
		<defName>Roadwanderer_Blueprint</defName>
		<label>公路行者</label>
		<description>长度缩小，动力不变，公路行者依然保持着原有的性能，只是尺寸上更加紧凑了，虽然后排乘客现在要和货物坐在一起，但也比无法乘坐强。\n\n&lt;color=#bb8f04&gt;乘员:&lt;/color&gt; 驾驶员 x1, 乘客 x2\n&lt;color=#bb8f04&gt;动力:&lt;/color&gt; 化合燃料</description>
		<designationCategory>VF_Vehicles</designationCategory>
		<graphicData>
			<texPath>Things/Vehicles/Roadwanderer/Roadwanderer</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,6)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToBuild>29000</WorkToBuild>
			<Flammability>0.05</Flammability>
		</statBases>
		<size>(2,4)</size>
		<researchPrerequisites>
			<li>MechanicalEngineeringBasics</li>
		</researchPrerequisites>
		<costList>
			<EngineLight>1</EngineLight>
			<ComponentHeavyCasting>12</ComponentHeavyCasting>
			<ComponentWheelTire>4</ComponentWheelTire>
			<SimplePlates>60</SimplePlates>
			<StrongPlates>35</StrongPlates>
		</costList>	
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<thingToSpawn>Roadwanderer</thingToSpawn>
		<constructionSkillPrerequisite>12</constructionSkillPrerequisite>
	</Vehicles.VehicleBuildDef>
</Defs>
