<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef Name="mkiihuhuApparelArmorBase" ParentName="ArmorMachineableBase" Abstract="True">
		<techLevel>Spacer</techLevel>
		<tradeTags>
			<li>HiTechArmor</li>
		</tradeTags>
		<statBases>
			<Flammability>0.4</Flammability>
		</statBases>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Legs</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>1</weight>
					<only>(0.9,0.9,0.9)</only>
				</li>
			</options>
		</colorGenerator>
		<comps>
			<li Class="CompProperties_Biocodable"/>
		</comps>
	</ThingDef>
	<!--=========NS轻型哨兵装甲 =========-->
	<ThingDef ParentName="mkiihuhuApparelArmorBase">
		<defName>PS2BO_body_Light</defName>
		<label>NS light power armor</label>
		<description>The lightweight power armor made from the Nanite System, equipped with an auxiliary power system built into the armor itself, allows the wearer to move freely and is suitable for security personnel and scouts working in low-risk areas.</description>
		<statBases>
			<WorkToMake>43000</WorkToMake>
			<MarketValue>2400</MarketValue>
			<MaxHitPoints>400</MaxHitPoints>
			<Mass>30</Mass>
			<ArmorRating_Sharp>18</ArmorRating_Sharp>
			<ArmorRating_Blunt>55</ArmorRating_Blunt>
			<ArmorRating_Heat>0.25</ArmorRating_Heat>
			<Insulation_Cold>24</Insulation_Cold>
			<Insulation_Heat>14</Insulation_Heat>
			<EquipDelay>6</EquipDelay>
			<Bulk>22</Bulk>
			<WornBulk>10</WornBulk>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>0.1</MoveSpeed>
			<MentalBreakThreshold>-0.2</MentalBreakThreshold>
			<CarryWeight>25</CarryWeight>
			<CarryBulk>20</CarryBulk>
			<CarryingCapacity>30</CarryingCapacity>
		</equippedStatOffsets>
		<tradeability>All</tradeability>
		<tradeTags>
			<li>HiTechArmor</li>
			<li>Armor</li>
		</tradeTags>
		<costList>
			<MechanismSpacer>8</MechanismSpacer>
			<ComponentIndustrial>8</ComponentIndustrial>
			<Polymers>70</Polymers>
			<Microelectronics>4</Microelectronics>
			<Kevlar>30</Kevlar>
			<Synthread>50</Synthread>
			<Carbon>30</Carbon>
			<TungstenIngot>200</TungstenIngot>
		</costList>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>FlakArmorIV</researchPrerequisite>
			<skillRequirements>
				<Crafting>15</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>ElectricTailoringBench</li>
				<li>RoboticTailoringBench</li>
			</recipeUsers>
			<workSkill>Crafting</workSkill>
		</recipeMaker>
		<graphicData>
			<texPath>Things/Apparel/BO1_Light/BO1_Item</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Hands</li>
				<li>Feet</li>
			</bodyPartGroups>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<defaultOutfitTags>
				<li>ArmorTier_VII</li>
			</defaultOutfitTags>
			<scoreOffset>4</scoreOffset>
			<wornGraphicPath>Things/Apparel/BO1_Light/BO1</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
		</apparel>
	</ThingDef>
	<!--========= NS防弹衣 =========-->
	<ThingDef ParentName="mkiihuhuApparelArmorBase">
		<defName>PS2BO_body_FlakVest</defName>
		<label>NS standard bullet-proof vest</label>
		<description>The standard bullet-proof vest producer in the Nanite System, issued to all NS operatives for self-defense in emergency situations. Compared to traditional flak vests at rimworld, this vest is lighter and offers better resistance to blunt hit.</description>
		<statBases>
			<WorkToMake>36000</WorkToMake>
			<MarketValue>2200</MarketValue>
			<MaxHitPoints>300</MaxHitPoints>
			<Mass>11</Mass>
			<ArmorRating_Sharp>17</ArmorRating_Sharp>
			<ArmorRating_Blunt>22</ArmorRating_Blunt>
			<ArmorRating_Heat>0.4</ArmorRating_Heat>
			<Insulation_Cold>6</Insulation_Cold>
			<Insulation_Heat>2</Insulation_Heat>
			<EquipDelay>2</EquipDelay>
			<Bulk>14</Bulk>
			<WornBulk>8</WornBulk>
		</statBases>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>FlakArmorIV</researchPrerequisite>
			<skillRequirements>
				<Crafting>13</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>ElectricTailoringBench</li>
				<li>RoboticTailoringBench</li>
			</recipeUsers>
			<workSkill>Crafting</workSkill>
		</recipeMaker>
		<graphicData>
			<texPath>Things/Apparel/NSO_FlakVest/NSOFlakVest_Item</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<tradeability>All</tradeability>
		<tradeTags>
			<li>HiTechArmor</li>
			<li>Armor</li>
		</tradeTags>
		<costList>
			<MechanismSpacer>4</MechanismSpacer>
			<ComponentIndustrial>4</ComponentIndustrial>
			<Polymers>50</Polymers>
			<Kevlar>60</Kevlar>
			<Synthread>60</Synthread>
			<Carbon>60</Carbon>
			<TungstenIngot>120</TungstenIngot>
		</costList>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Legs</li>
			</bodyPartGroups>
			<layers>
				<li>Middle</li>
			</layers>
			<scoreOffset>4</scoreOffset>
			<wornGraphicPath>Things/Apparel/NSO_FlakVest/NSOFlakVest</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<defaultOutfitTags>
				<li>ArmorTier_VII</li>
			</defaultOutfitTags>
		</apparel>
	</ThingDef>
	<!--========= NS重型突击装甲 =========-->
	<ThingDef ParentName="mkiihuhuApparelArmorBase">
		<defName>PS2BO_body_Heavy</defName>
		<label>NS Heavy assault power armor</label>
		<description>The heavy assault armor generated by the Nanite System, commonly found in high-intensity war areas. The heavy armor and shield generator can block a large number of bullets for soldiers , and play an important role in the attack and defense of important areas.</description>
		<statBases>
			<MarketValue>4600</MarketValue>
			<WorkToMake>55000</WorkToMake>
			<MaxHitPoints>550</MaxHitPoints>
			<ArmorRating_Sharp>25</ArmorRating_Sharp>
			<ArmorRating_Blunt>120</ArmorRating_Blunt>
			<ArmorRating_Heat>0.55</ArmorRating_Heat>
			<Insulation_Cold>30</Insulation_Cold>
			<Insulation_Heat>10</Insulation_Heat>
			<Mass>48</Mass>
			<EquipDelay>8</EquipDelay>
			<Bulk>14</Bulk>
            <WornBulk>12</WornBulk>
		</statBases>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>FlakArmorV</researchPrerequisite>
			<skillRequirements>
				<Crafting>16</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>RoboticTailoringBench</li>
			</recipeUsers>
			<workSkill>Crafting</workSkill>
		</recipeMaker>
		<equippedStatOffsets>
			<ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">0.25</ToxicEnvironmentResistance>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.3</SlaveSuppressionOffset>
			<IncomingDamageFactor>-0.05</IncomingDamageFactor>
			<PainShockThreshold>0.15</PainShockThreshold>
			<CarryWeight>35</CarryWeight>
            <CarryBulk>30</CarryBulk>
			<MoveSpeed>-0.15</MoveSpeed>
			<Suppressability>-0.2</Suppressability>
			<CarryingCapacity>40</CarryingCapacity>
		</equippedStatOffsets>
		<tradeability>All</tradeability>
		<tradeTags>
			<li>HiTechArmor</li>
			<li>Armor</li>
		</tradeTags>
		<costList>
			<DiamondPowder>4</DiamondPowder>
			<CarbonNanotubes>150</CarbonNanotubes>
			<MechanismSpacer>10</MechanismSpacer>
			<ComponentIndustrial>10</ComponentIndustrial>
			<Polymers>70</Polymers>
			<Microelectronics>2</Microelectronics>
			<Kevlar>35</Kevlar>
			<Synthread>70</Synthread>
			<Carbon>40</Carbon>
			<TungstenIngot>450</TungstenIngot>
		</costList>	
		<graphicData>
			<texPath>Things/Apparel/BOHA_Heavy/BOHA_Item</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawRotated>false</drawRotated>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Hands</li>
				<li>Feet</li>
			</bodyPartGroups>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<scoreOffset>4</scoreOffset>
			<wornGraphicPath>Things/Apparel/BOHA_Heavy/BOHA</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<defaultOutfitTags>
				<li>ArmorTier_VIII</li>
			</defaultOutfitTags>
		</apparel>
	</ThingDef>
</Defs>