<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <ThingDef ParentName="DS_Weapon">
        <defName>DS_PulseRifle</defName>
        <label>SWS pulse rifle</label>
        <description>A Military-grade assault rifle discharges ultra-low caliber rounds at hypersonic speeds, each carrying tremendous amounts of kinetic energy.</description>
        <graphicData>
            <texPath>Things/Weapons/PulseRifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
			 <drawSize>1.18</drawSize>
        </graphicData>
        <soundInteract>DS_Interact_Rifle</soundInteract>
        <statBases>
			<WorkToMake>38000</WorkToMake>
			<Mass>6</Mass>
			<RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
			<SightsEfficiency>1.3</SightsEfficiency>
			<ShotSpread>0.06</ShotSpread>
			<SwayFactor>0.9</SwayFactor>
			<Bulk>8</Bulk>
        </statBases>
        <costList>
			<HiTechWeaponComponents>25</HiTechWeaponComponents>
			<MechanismSpacer>15</MechanismSpacer>
			<ComponentIndustrial>20</ComponentIndustrial>
			<Plastic>50</Plastic>
			<Polymers>150</Polymers>
			<SimpleElectronic>15</SimpleElectronic>
			<Microelectronics>5</Microelectronics>
			<Supermagnet>15</Supermagnet>
        </costList>
		<weaponTags>
			<li>CE_AI_AssaultWeapon</li>
		</weaponTags>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>DS_CE_Bullet_PulseRifle</defaultProjectile>
				<warmupTime>0.8</warmupTime>
				<range>90</range>
				<burstShotCount>10</burstShotCount>
				<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
				<soundCast>DS_Shot_PulseRifle</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>1.55</cooldownTime>
				<chanceFactor>1.5</chanceFactor>
				<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>5</power>
				<cooldownTime>2.02</cooldownTime>
				<armorPenetrationBlunt>1.630</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>muzzle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>8</power>
				<cooldownTime>1.55</cooldownTime>
				<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
			</li>
		</tools>
		<comps>
			<li Class="ProjectParagon.Core.FightSystem.CompProperties_WeaponSpecialization">
				<subWeaponSpecialization>AssaultRifles</subWeaponSpecialization>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>50</magazineSize>
				<reloadTime>4</reloadTime>
				<ammoSet>DS_AmmoSet_PulseRifle</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
				<aimedBurstShotCount>5</aimedBurstShotCount>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<DrawSize>1,1</DrawSize>
				<DrawOffset>0.0,0.0</DrawOffset>
			</li>
		</modExtensions>
    </ThingDef>

    <SoundDef>
        <defName>DS_Shot_PulseRifle</defName>
        <context>MapOnly</context>
        <eventNames />
        <maxSimultaneous>10</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>Weapons/PulseRifle</clipPath>
                    </li>
                </grains>
                <pitchRange>
                    <min>1</min>
                    <max>1.112391</max>
                </pitchRange>
                <paramMappings>
                    <li>
                        <inParam Class="SoundParamSource_CameraAltitude" />
                        <outParam Class="SoundParamTarget_PropertyLowPass">
                            <filterProperty>Cutoff</filterProperty>
                        </outParam>
                        <paramUpdateMode>Constant</paramUpdateMode>
                        <curve>
                            <points>
                                <li>
                                    <loc>
                                        <x>17.08957</x>
                                        <y>21001.8</y>
                                    </loc>
                                </li>
                                <li>
                                    <loc>
                                        <x>24.77761</x>
                                        <y>12701.95</y>
                                    </loc>
                                </li>
                                <li>
                                    <loc>
                                        <x>32.786</x>
                                        <y>7168.717</y>
                                    </loc>
                                </li>
                                <li>
                                    <loc>
                                        <x>45.91975</x>
                                        <y>4270.358</y>
                                    </loc>
                                </li>
                                <li>
                                    <loc>
                                        <x>66.10088</x>
                                        <y>2557.69</y>
                                    </loc>
                                </li>
                            </points>
                        </curve>
                    </li>
                </paramMappings>
                <filters>
                    <li Class="SoundFilterLowPass">
                        <cutoffFrequency>10000</cutoffFrequency>
                        <lowpassResonaceQ>1</lowpassResonaceQ>
                    </li>
                </filters>  
                <sustainLoop>False</sustainLoop>
            </li>
        </subSounds>
    </SoundDef>
</Defs>