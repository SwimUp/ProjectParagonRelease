<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingCategoryDef>
        <defName>DS_Category_ContactEnergy</defName>
        <label>contact energy cell</label>
        <parent>AmmoAdvanced</parent>
        <iconPath>Things/Ammo/ContactEngergy</iconPath>
    </ThingCategoryDef>

    <CombatExtended.AmmoSetDef>
        <defName>DS_AmmoSet_ContactBeam</defName>
        <label>Contact Energy</label>
        <ammoTypes>
            <DS_Ammo_ContactEnergy>DS_CE_Bullet_ContactBeam</DS_Ammo_ContactEnergy>
        </ammoTypes>
    </CombatExtended.AmmoSetDef>

    <ThingDef ParentName="BaseBullet">
        <defName>DS_CE_Bullet_ContactBeam</defName>
        <label>plasma Bolt</label>
        <graphicData>
            <texPath>Things/Projectiles/ContactBeamTrail</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>MoteGlow</shaderType>
            <drawSize>(1,1.3)</drawSize>
        </graphicData>
        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <speed>170</speed>
            <damageDef>Bomb</damageDef>
            <damageAmountBase>33</damageAmountBase>
            <explosionRadius>1</explosionRadius>
            <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
            <secondaryDamage>
                <li>
                    <def>Flame_Secondary</def>
                    <amount>18</amount>
                </li>
            </secondaryDamage>
        </projectile>
    </ThingDef>

    <!-- contact beam ammo -->
    <ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
        <defName>DS_Ammo_ContactEnergy</defName>
        <label>contact energy cell</label>
        <description>Energy cell of the contact beam.</description>
        <statBases>
			<Mass>0.154</Mass>
			<Bulk>0.31</Bulk>
			<MarketValue>1.9</MarketValue>
		</statBases>
        <graphicData>
            <texPath>Things/Ammo/ContactEngergy</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.8</drawSize>
        </graphicData>
        <tradeTags>
			<li>CE_AutoEnableTrade</li>
		</tradeTags>
        <stackLimit>500</stackLimit>
        <ammoClass>Charged</ammoClass>
        <thingCategories>
            <li>DS_Category_ContactEnergy</li>
        </thingCategories>
    </ThingDef>

