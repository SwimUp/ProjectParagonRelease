				<count>12</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>MagnesiumIngot</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>SulphuricAcid</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Supermagnet</li>
