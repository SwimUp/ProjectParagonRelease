            <DS_Ammo_ForceEnergy>DS_CE_Bullet_ForceGun</DS_Ammo_ForceEnergy>
        </ammoTypes>
    </CombatExtended.AmmoSetDef>

    <ThingDef ParentName="BaseBullet">
        <defName>DS_CE_Bullet_ForceGun</defName>
        <label>force energy</label>
        <graphicData>
            <texPath>Things/Projectiles/ContactBeamTrail</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>MoteGlow</shaderType>
            <drawSize>(1,1.3)</drawSize>
        </graphicData>
        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <speed>200</speed>
            <damageDef>Bomb</damageDef>
            <damageAmountBase>42</damageAmountBase>
            <dropsCasings>false</dropsCasings>
        </projectile>
    </ThingDef>

    <!-- ammo: force engergy-->
    <ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
        <defName>DS_Ammo_ForceEnergy</defName>
        <label>force energy cell</label>
        <description>Energy cell of the force gun.</description>
        <statBases>
            <Mass>0.154</Mass>
			<Bulk>0.31</Bulk>
			<MarketValue>1.9</MarketValue>
        </statBases>
        <graphicData>
            <texPath>Things/Ammo/ForceEnergy</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.8</drawSize>
        </graphicData>
        <tradeTags>
            <li>CE_AutoEnableTrade</li>
        </tradeTags>
        <stackLimit>250</stackLimit>
        <ammoClass>Charged</ammoClass>
        <thingCategories>
            <li>DS_Category_ForceEnergy</li>
        </thingCategories>
        
    </ThingDef>

