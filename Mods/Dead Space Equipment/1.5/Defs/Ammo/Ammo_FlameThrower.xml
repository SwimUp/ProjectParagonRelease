			</li>
			<li>
				<filter>
					<thingDefs>
						<li>MagnesiumIngot</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>SulphuricAcid</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
