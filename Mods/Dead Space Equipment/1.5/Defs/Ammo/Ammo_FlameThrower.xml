    <!-- ammo: Hydrazine Fuel -->
    <ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
        <defName>DS_Ammo_HydrazineFuel</defName>
        <label>hydrazine fuel</label>
        <graphicData>
            <texPath>Things/Ammo/HydrazineFuel</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.8</drawSize>
        </graphicData>
        <statBases>
            <MarketValue>0.3</MarketValue>
            <MaxHitPoints>70</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>0.05</Mass>
            <Bulk>0.1</Bulk>
        </statBases>
        <tradeTags>
			<li>CE_AutoEnableTrade</li>
		</tradeTags>
        <ammoClass>ThermobaricFuel</ammoClass>
        <comps>
            <li Class="CombatExtended.CompProperties_ExplosiveCE">
                <damageAmountBase>3</damageAmountBase>
                <explosiveDamageType>Flame</explosiveDamageType>
                <explosiveRadius>1</explosiveRadius>
                <preExplosionSpawnThingDef>Filth_Diesel</preExplosionSpawnThingDef>
