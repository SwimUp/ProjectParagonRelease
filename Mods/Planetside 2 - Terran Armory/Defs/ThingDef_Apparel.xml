<Defs>
	<!--Bastion-->
	<ThingDef ParentName="ApparelMakeableBase">
		<defName>Gs_Armor_TerraP_Bastion</defName>
		<label>Terran painted bastion armor</label>
		<graphicData>
			<texPath>Things/Armor/BastionPainted/Bastion</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.3</drawSize>
		</graphicData>
		<techLevel>Spacer</techLevel>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>FlakArmorIV</researchPrerequisite>
			<skillRequirements>
				<Crafting>15</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>ElectricTailoringBench</li>
				<li>RoboticTailoringBench</li>
			</recipeUsers>
			<workSkill>Crafting</workSkill>
		</recipeMaker>
		<statBases>
			<WorkToMake>42000</WorkToMake>
			<MarketValue>2500</MarketValue>
			<MaxHitPoints>550</MaxHitPoints>
			<Mass>24</Mass>
			<ArmorRating_Sharp>18</ArmorRating_Sharp>
			<ArmorRating_Blunt>85</ArmorRating_Blunt>
			<ArmorRating_Heat>0.4</ArmorRating_Heat>
			<Insulation_Cold>23</Insulation_Cold>
			<Insulation_Heat>8</Insulation_Heat>
			<EquipDelay>6</EquipDelay>
			<Bulk>11</Bulk>
            <WornBulk>9</WornBulk>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.10</MoveSpeed>
		</equippedStatOffsets>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<tradeability>All</tradeability>
		<tradeTags>
			<li>HiTechArmor</li>
			<li>Armor</li>
		</tradeTags>
		<costList>
			<MechanismSpacer>6</MechanismSpacer>
			<ComponentIndustrial>6</ComponentIndustrial>
			<Polymers>80</Polymers>
			<Kevlar>25</Kevlar>
			<Synthread>50</Synthread>
			<Carbon>25</Carbon>
			<TungstenIngot>180</TungstenIngot>
		</costList>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<defaultOutfitTags>
				<li>ArmorTier_VII</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<wornGraphicPath>Things/Armor/BastionPainted/Bastion</wornGraphicPath>
		</apparel>
	</ThingDef>
